{
  "$type": "MixItUp.Base.Model.Overlay.Widgets.OverlayWidgetV3Model, MixItUp.Base",
  "Name": "Twitch Bowl",
  "Item": {
    "$type": "MixItUp.Base.Model.Overlay.OverlayCustomV3Model, MixItUp.Base",
    "ID": "8ec806e2-9634-4cc1-bf2b-0138998f1446",
    "HTML": "<!doctype html>\n<html lang=\"en\"><head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Twitch Bowl</title>\n<!--\n  TWITCH BOWL, version 3: the whole overlay and its editor in one file.\n\n  - Inside Mix It Up or OBS, it shows only the overlay: a bowl that fills with balls.\n  - Opened straight from your computer in Chrome (double-click), it shows the editor.\n  - Add #edit to the end of the address to force the editor, or #overlay to force the overlay.\n\n  bowl-guide.html explains every part of this file. MIXITUP_SETUP.md says how to put it on stream.\n  Mix It Up rewrites a dollar sign followed by letters, and a word wrapped in curly brackets,\n  everywhere in a widget. So this file never contains either one.\n-->\n<style>\n  /* ---------- Colours (used by the editor) ---------- */\n  :root {\n    --page: #141418;\n    --panel: #1e1e24;\n    --line: #33333c;\n    --text: #ececf1;\n    --muted: #a0a0ad;\n    --accent: #a970ff;\n    --danger: #ff7a85;\n  }\n\n  /* ---------- Overlay: just the stage, on a see-through page ---------- */\n  * { box-sizing: border-box; }\n  html, body { margin: 0; }\n  body { overflow: hidden; background: transparent; }\n  #stage-box { position: relative; width: 100vmin; height: 100vmin; }\n  #stage, #editor-stage { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }\n  [hidden] { display: none !important; }\n\n  /* ---------- Editor: everything below only applies when the editor is showing ---------- */\n  body.editing {\n    overflow: auto;\n    background: var(--page);\n    color: var(--text);\n    font: 14px/1.45 system-ui, \"Segoe UI\", sans-serif;\n  }\n  .editing main {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) 340px;\n    gap: 16px;\n    padding: 16px;\n    min-height: 100vh;\n  }\n  .editing #stage-box {\n    justify-self: center;\n    align-self: start;\n    position: sticky;\n    top: 16px;\n    width: min(100%, calc(100vh - 32px));\n    height: auto;\n    aspect-ratio: 1;\n    border-radius: 8px;\n    overflow: hidden;\n    background: repeating-conic-gradient(#2a2a31 0 25%, #222228 0 50%) 0 0 / 32px 32px;\n  }\n  #editor-stage { touch-action: none; cursor: crosshair; }\n  #editor-stage.moving { cursor: move; }\n  #editor-stage.moving #handles, #editor-stage.moving #outline { pointer-events: none; opacity: 0.5; }\n  #outline { fill: none; stroke: var(--accent); stroke-width: 8; stroke-linecap: round; stroke-linejoin: round; opacity: 0.75; cursor: copy; }\n  #handles circle { fill: #fff; stroke: var(--accent); stroke-width: 3; cursor: grab; }\n  #drop { cursor: move; }\n  #drop-band { fill: var(--accent); opacity: 0.35; }\n  #drop-arrow { fill: var(--accent); }\n  #drop-ball { clip-path: circle(50%); }\n  #pegs circle { stroke: var(--accent); stroke-width: 3; cursor: grab; }\n  #pegs.off { opacity: 0.4; }\n  #editor-stage.pegging #handles, #editor-stage.pegging #outline { pointer-events: none; opacity: 0.5; }\n  .thumbs { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }\n  .thumbs button { position: relative; width: 48px; height: 48px; padding: 4px; }\n  .thumbs img { width: 100%; height: 100%; object-fit: contain; }\n  .thumbs span { position: absolute; top: -6px; right: -6px; width: 18px; height: 18px; border-radius: 50%; background: var(--danger); color: #17121f; font-size: 12px; line-height: 18px; }\n  aside { display: flex; flex-direction: column; gap: 16px; }\n  h1 { margin: 0; font-size: 18px; }\n  h2 { margin: 0 0 8px; font-size: 12px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); }\n  section { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 12px; }\n  header { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }\n  #status { color: var(--muted); font-size: 13px; text-align: right; }\n  .row { display: flex; gap: 8px; margin-top: 8px; }\n  .row:first-child { margin-top: 0; }\n  .row > * { flex: 1; }\n  .wide { width: 100%; margin-top: 8px; }\n  button {\n    padding: 7px 10px;\n    border: 1px solid var(--line);\n    border-radius: 6px;\n    background: #2a2a32;\n    color: var(--text);\n    font: inherit;\n    cursor: pointer;\n  }\n  button:hover { border-color: var(--muted); }\n  button:disabled { opacity: 0.5; cursor: default; }\n  button.active, button.primary { background: var(--accent); border-color: var(--accent); color: #17121f; font-weight: 600; }\n  button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }\n  .picture {\n    position: relative;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 6px;\n    padding: 8px;\n    border: 1px dashed var(--line);\n    border-radius: 6px;\n    color: var(--muted);\n    cursor: pointer;\n    text-align: center;\n  }\n  .picture:hover { border-color: var(--muted); color: var(--text); }\n  .picture img { width: 100%; height: 64px; object-fit: contain; }\n  .picture input { position: absolute; opacity: 0; width: 1px; height: 1px; }\n  .hint { margin: 8px 0 0; color: var(--muted); font-size: 13px; }\n  .setting { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 2px 8px; margin-bottom: 10px; }\n  .setting output { color: var(--muted); font-variant-numeric: tabular-nums; }\n  .setting input[type=\"range\"] { grid-column: 1 / -1; width: 100%; accent-color: var(--accent); }\n  .check { display: flex; gap: 8px; align-items: center; margin-bottom: 10px; }\n  .check input { accent-color: var(--accent); width: 16px; height: 16px; }\n  .colors label { display: flex; flex-direction: column; align-items: center; gap: 2px; font-size: 12px; color: var(--muted); }\n  .colors input { width: 100%; height: 28px; padding: 0; border: 1px solid var(--line); border-radius: 6px; background: none; }\n  input[type=\"number\"], input[type=\"text\"], select, textarea {\n    padding: 5px 7px;\n    border: 1px solid var(--line);\n    border-radius: 6px;\n    background: #2a2a32;\n    color: var(--text);\n    font: inherit;\n  }\n  input[type=\"number\"] { width: 110px; }\n  input[type=\"text\"], select { width: 100%; }\n  .bowl-list { display: flex; flex-direction: column; gap: 6px; }\n  .bowl-item { display: flex; justify-content: space-between; align-items: center; text-align: left; }\n  .bowl-item[aria-pressed=\"true\"] { border-color: var(--accent); box-shadow: inset 3px 0 0 var(--accent); }\n  .badge { padding: 1px 7px; border-radius: 999px; background: var(--accent); color: #17121f; font-size: 11px; font-weight: 700; }\n  .warning { color: var(--danger); }\n  dialog { width: min(640px, calc(100vw - 32px)); padding: 16px; border: 1px solid var(--line); border-radius: 10px; background: var(--panel); color: var(--text); }\n  dialog::backdrop { background: rgba(0, 0, 0, 0.6); }\n  dialog textarea { width: 100%; height: 260px; margin: 8px 0; font: 12px/1.4 Consolas, monospace; resize: vertical; }\n  a { color: var(--accent); }\n  @media (max-width: 900px) {\n    .editing main { grid-template-columns: minmax(0, 1fr); }\n    .editing #stage-box { position: relative; top: 0; width: 100%; }\n  }\n</style>\n</head>\n<body>\n<main>\n  <!-- The stage: an 800 x 800 canvas for the balls, with the editor's drawing layer on top. -->\n  <div id=\"stage-box\">\n    <canvas id=\"stage\" width=\"800\" height=\"800\"></canvas>\n    <svg id=\"editor-stage\" viewBox=\"0 0 800 800\" xmlns=\"http://www.w3.org/2000/svg\" hidden=\"\">\n      <image id=\"bowl\"></image>\n      <image id=\"bowl-depth\"></image>\n      <image id=\"bowl-front\"></image>\n      <g id=\"pegs\"></g>\n      <polyline id=\"outline\"></polyline>\n      <g id=\"handles\"></g>\n      <g id=\"drop\">\n        <rect id=\"drop-band\" height=\"10\" rx=\"5\"></rect>\n        <image id=\"drop-ball\"></image>\n        <path id=\"drop-arrow\"></path>\n      </g>\n    </svg>\n  </div>\n\n  <!-- The editor panel. Hidden in OBS and Mix It Up. -->\n  <aside id=\"panel\" hidden=\"\">\n    <header>\n      <h1>Bowl Editor</h1>\n      <span id=\"status\" role=\"status\">Saved</span>\n    </header>\n\n    <section>\n      <h2>Bowls</h2>\n      <div id=\"bowl-list\" class=\"bowl-list\"></div>\n      <div class=\"row\">\n        <button id=\"bowl-add\">Add</button>\n        <button id=\"bowl-duplicate\">Duplicate</button>\n      </div>\n      <div class=\"row\">\n        <button id=\"bowl-rename\">Rename</button>\n        <button id=\"bowl-delete\">Delete</button>\n      </div>\n      <button id=\"bowl-live\" class=\"wide\">Make this the live bowl</button>\n      <p class=\"hint\">Click a bowl to edit it. The live bowl is the one your stream starts with.</p>\n    </section>\n\n    <section>\n      <h2>Bowl pictures</h2>\n      <div class=\"row\">\n        <label class=\"picture\">\n          <img id=\"back-preview\" alt=\"This bowl's back picture\">\n          <span>Back</span>\n          <input data-layer=\"picture\" type=\"file\" accept=\"image/*\" multiple=\"\">\n        </label>\n        <label class=\"picture\">\n          <img id=\"front-preview\" alt=\"This bowl's front picture\">\n          <span>Front</span>\n          <input data-layer=\"front\" type=\"file\" accept=\"image/*\">\n        </label>\n        <label class=\"picture\">\n          <img id=\"depth-preview\" alt=\"This bowl's depth picture\">\n          <span>Depth</span>\n          <input data-layer=\"depth\" type=\"file\" accept=\"image/*\">\n        </label>\n      </div>\n      <div class=\"row\">\n        <button id=\"remove-front\">No front</button>\n        <button id=\"remove-depth\">No depth</button>\n        <button id=\"line-up\">Line up</button>\n      </div>\n      <label class=\"check\" style=\"margin-top: 10px\"><input type=\"checkbox\" data-bowl-check=\"depthInFront\"> Depth goes in front of the balls</label>\n      <p class=\"hint\">Back goes behind the balls, Front in front of them, Depth is an extra layer. Choose 2 or 3 pictures at once with Back: names with \"front\", \"back\" or \"depth\" are sorted by themselves. Layers line up by themselves; pull them apart with Move picture.</p>\n      <h2 style=\"margin-top: 14px\">Ball pictures</h2>\n      <label class=\"picture\">\n        <span>Add ball pictures (choose several at once)</span>\n        <input id=\"ball-file\" type=\"file\" accept=\"image/*\" multiple=\"\">\n      </label>\n      <div id=\"ball-pictures\" class=\"thumbs\"></div>\n      <p class=\"hint\">Each ball uses one of these. Click one to remove it.</p>\n    </section>\n\n    <section id=\"tools\">\n      <h2>Bowl shape</h2>\n      <div class=\"row\">\n        <button id=\"draw-mode\" class=\"active\">Draw outline</button>\n        <button id=\"move-mode\">Move picture</button>\n        <button id=\"peg-mode\">Place pegs</button>\n      </div>\n      <select id=\"move-what\" class=\"wide\">\n        <option value=\"all\">Move the whole bowl</option>\n        <option value=\"front\">Move only the front picture</option>\n        <option value=\"depth\">Move only the depth picture</option>\n      </select>\n      <p class=\"hint\" id=\"hint\"></p>\n      <div class=\"row\">\n        <button id=\"undo\">Undo</button>\n        <button id=\"clear\">Clear outline</button>\n      </div>\n    </section>\n\n    <section>\n      <h2>This bowl</h2>\n      <div id=\"bowl-sliders\"></div>\n      <label class=\"setting\">\n        <span>Breaks</span>\n        <select id=\"break-mode\" style=\"width: auto\">\n          <option value=\"count\">at a number of balls</option>\n          <option value=\"auto\">when the pile reaches the top</option>\n          <option value=\"off\">never</option>\n        </select>\n      </label>\n      <label class=\"setting\" id=\"break-at-row\">\n        <span>Breaks at ___ balls</span>\n        <input id=\"break-at\" type=\"number\" min=\"1\" step=\"1\">\n      </label>\n      <p class=\"hint\" id=\"break-hint\"></p>\n    </section>\n\n    <section>\n      <h2>Balls and physics</h2>\n      <div id=\"shared-sliders\"></div>\n      <label class=\"setting\">\n        <span>Bits for one ball</span>\n        <input id=\"bits\" type=\"number\" min=\"1\" step=\"1\">\n      </label>\n    </section>\n\n    <section>\n      <h2>Breaking</h2>\n      <div id=\"break-sliders\"></div>\n      <label class=\"check\"><input id=\"cycle\" type=\"checkbox\"> The next bowl in the list comes back</label>\n    </section>\n\n    <section>\n      <h2>Gambling mode</h2>\n      <label class=\"check\"><input type=\"checkbox\" data-check=\"gambling\"> Pegs on: balls bounce off them and may miss the bowl</label>\n      <div id=\"peg-sliders\"></div>\n      <label class=\"setting\"><span>Peg colour</span><input type=\"color\" data-color=\"pegColor\" style=\"width: 60px; height: 28px; padding: 0\"></label>\n      <div class=\"row\">\n        <button id=\"peg-pattern\">Peg pattern</button>\n        <button id=\"clear-pegs\">Clear pegs</button>\n      </div>\n      <p class=\"hint\">Place pegs with the \"Place pegs\" tool. Balls that miss the bowl are lost.</p>\n    </section>\n\n    <section>\n      <h2>Fun</h2>\n      <label class=\"check\"><input type=\"checkbox\" data-check=\"grabBalls\"> Let me grab balls with the mouse (in OBS: Interact)</label>\n      <label class=\"check\"><input type=\"checkbox\" data-check=\"showNames\"> Show who sent each ball</label>\n      <label class=\"check\"><input type=\"checkbox\" data-check=\"colorByEvent\"> Colour balls by event</label>\n      <div class=\"row colors\">\n        <label>Follow<input type=\"color\" data-color=\"followColor\"></label>\n        <label>Sub<input type=\"color\" data-color=\"subColor\"></label>\n        <label>Bits<input type=\"color\" data-color=\"bitsColor\"></label>\n        <label>1st chat<input type=\"color\" data-color=\"chatColor\"></label>\n      </div>\n      <label class=\"check\" style=\"margin-top: 10px\"><input type=\"checkbox\" data-check=\"bubbles\"> Bubbles when it breaks</label>\n      <label class=\"check\"><input type=\"checkbox\" data-check=\"showCounter\"> Show the count above the bowl</label>\n      <div id=\"fun-sliders\"></div>\n    </section>\n\n    <section>\n      <h2>Try it</h2>\n      <button id=\"test-toggle\" class=\"wide\" style=\"margin-top: 0\">Test the physics</button>\n      <div id=\"test-buttons\" hidden=\"\">\n        <div class=\"row\">\n          <button data-add=\"1\">+1</button>\n          <button data-add=\"10\">+10</button>\n          <button data-add=\"50\">+50</button>\n        </div>\n        <div class=\"row\">\n          <button data-kind=\"f\">Follow</button>\n          <button data-kind=\"s\">Sub</button>\n          <button data-kind=\"b\">Bits</button>\n          <button data-kind=\"c\">1st chat</button>\n        </div>\n        <div class=\"row\">\n          <button id=\"test-shake\">Shake</button>\n          <button id=\"test-empty\">Empty</button>\n          <button id=\"test-break\">Break now</button>\n        </div>\n      </div>\n      <p class=\"hint\">Test balls stay in this page. Your real bowl and OBS aren't affected.</p>\n    </section>\n\n    <section>\n      <h2>Put it on stream</h2>\n      <button id=\"download-widget\" class=\"wide primary\" style=\"margin-top: 0\">Download Mix It Up widget</button>\n      <p class=\"hint\">Makes a .miuoverlay file. In Mix It Up: Overlay Widgets, Import. You can send this file to anyone.</p>\n      <button id=\"copy-for-miu\" class=\"wide\">Copy for Mix It Up</button>\n      <p class=\"hint\">Copies the whole bowl, to paste into an existing widget's HTML tab.</p>\n      <button id=\"save-copy\" class=\"wide\">Save a copy with these settings</button>\n      <div class=\"row\">\n        <button id=\"export\">Export settings</button>\n        <button id=\"import\">Import settings</button>\n      </div>\n      <p class=\"hint\">Your edits are kept in this browser. Copy or download again after changing things.</p>\n    </section>\n\n    <section>\n      <h2>Mix It Up</h2>\n      <label class=\"setting\" style=\"grid-template-columns: 1fr\">\n        <span>When the bowl breaks, run this Mix It Up command (optional)</span>\n        <input id=\"break-command\" type=\"text\" placeholder=\"Command ID\" spellcheck=\"false\">\n      </label>\n      <p class=\"hint\">Needs Mix It Up's Developer API service. MIXITUP_SETUP.md, step 4, shows how to find a command's ID.</p>\n    </section>\n\n    <section>\n      <h2>Real bowl</h2>\n      <button id=\"reset\" class=\"wide\" style=\"margin-top: 0\">Empty the real bowl</button>\n      <p class=\"hint\" id=\"reset-hint\"></p>\n      <button id=\"reset-cancel\" class=\"wide\" hidden=\"\">Don't empty it</button>\n    </section>\n  </aside>\n</main>\n\n<!-- One pop-up box, used by Export settings and Import settings. -->\n<dialog id=\"text-dialog\">\n  <h2 id=\"dialog-title\"></h2>\n  <p class=\"hint\" id=\"dialog-hint\"></p>\n  <textarea id=\"dialog-text\" spellcheck=\"false\"></textarea>\n  <div class=\"row\">\n    <button id=\"dialog-action\" class=\"primary\"></button>\n    <button id=\"dialog-close\">Close</button>\n  </div>\n</dialog>\n\n<!--\n  SETTINGS. \"Save a copy\", \"Copy for Mix It Up\" and \"Download Mix It Up widget\" rewrite this block.\n  Pictures are stored as text (data URLs), split into short lines.\n-->\n<script id=\"bowl-settings\" type=\"application/json\">\n{\n \"version\": 1,\n \"savedAt\": 0,\n \"ballSize\": 30,\n \"gravity\": 1,\n \"bounciness\": 0.3,\n \"friction\": 0.02,\n \"bitsPerBall\": 100,\n \"shards\": 7,\n \"returnSeconds\": 3,\n \"cycleBowls\": false,\n \"breakCommandId\": \"\",\n \"emptyToken\": \"\",\n \"emptyArmed\": false,\n \"liveBowlId\": \"bowl1\",\n \"showNames\": true,\n \"colorByEvent\": true,\n \"followColor\": \"#4fc3f7\",\n \"subColor\": \"#b388ff\",\n \"bitsColor\": \"#ffd54f\",\n \"chatColor\": \"#69f0ae\",\n \"bubbles\": true,\n \"showCounter\": false,\n \"volume\": 0.3,\n \"grabBalls\": true,\n \"ballPictures\": [\n  \"ball\"\n ],\n \"gambling\": false,\n \"pegSize\": 16,\n \"pegBounce\": 0.6,\n \"pegColor\": \"#ffffff\",\n \"widgetEvents\": true,\n \"bowls\": [\n  {\n   \"id\": \"bowl1\",\n   \"name\": \"Bowl 1\",\n   \"picture\": \"starter\",\n   \"x\": 80,\n   \"y\": 420,\n   \"width\": 640,\n   \"outline\": [\n    [104, 420],\n    [110, 486],\n    [127, 549],\n    [154, 607],\n    [191, 658],\n    [236, 699],\n    [287, 730],\n    [342, 750],\n    [400, 756],\n    [458, 750],\n    [513, 730],\n    [564, 699],\n    [609, 658],\n    [646, 607],\n    [673, 549],\n    [690, 486],\n    [696, 420]\n   ],\n   \"dropX\": 400,\n   \"dropY\": 30,\n   \"dropWidth\": 296,\n   \"breakMode\": \"count\",\n   \"breakAt\": null,\n   \"front\": \"\",\n   \"depth\": \"\",\n   \"depthInFront\": false,\n   \"frontX\": 0,\n   \"frontY\": 0,\n   \"depthX\": 0,\n   \"depthY\": 0,\n   \"pegs\": []\n  }\n ],\n \"pictures\": {\n  \"starter\": [\n   \"data:image/png;base64,\",\n   \"\",\n   \"\",\n   \"\",\n   \"\",\n   \"\",\n   \"\",\n   \"\",\n   \"\",\n   \"\",\n   \"\",\n   \"\",\n   \"\",\n   \"\",\n   \"\",\n   \"\",\n   \"\",\n   \"\",\n   \"\",\n   \"\",\n   \"\",\n   \"\",\n   \"\",\n   \"\",\n   \"\",\n   \"\",\n   \"\",\n   \"\",\n   \"\",\n   \"\",\n   \"\",\n   \"\",\n   \"\",\n   \"\",\n   \"\",\n   \"\",\n   \"\",\n   \"\",\n   \"Xh3sK2rm371dt13aYrSZIkSZKkgi7danzRxUHhV8PCriHTRQvPxkEUPWnhmT8P9S5esWewJ0mSJEmSpD6p4le/uuHPA8PsNuSqyq+Hhl/dihx9ddVaN4Ov9H1123U3f+avrs772p9/ZtnQNf5cJUmSdPX9/wEyYaACUIE+bAAAAABJRU5ErkJggg==\"\n  ],\n  \"ball\": [\n   \"data:image/png;base64,\",\n   \"\",\n   \"\",\n   \"\",\n   \"\"\n  ]\n }\n}\n</script>\n\n<!-- MATTER.JS, the physics engine, copied in unchanged apart from line breaks. -->\n<script>\n/*!\n * matter-js 0.20.0 by @liabru\n * http://brm.io/matter-js/\n * License MIT\n */\n!function(e,t){\"object\"==typeof exports&&\"object\"==typeof module?module.exports=t():\"function\