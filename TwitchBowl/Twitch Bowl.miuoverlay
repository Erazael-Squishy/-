ER_CALL = 10000; // The most balls one message can add, in case of a typo\nconst MAX_PICTURE = 1600; // Longest side kept when a bowl picture is uploaded\nconst MAX_BALL_PICTURE = 400; // Balls are small on screen, so their picture can be smaller\nconst PICTURE_LINE = 1000; // Characters per line when pictures are written into this file\nconst MIN_STEP = 16; // Pixels between points when drawing freehand\nconst SAVE_DELAY = 300; // The editor saves this long after the last change\nconst DEBRIS = { category: 2, mask: 2 }; // Falling balls only hit each other, never a bowl\nconst STORAGE = { settings: 'twitchBowl.settings', state: 'twitchBowl.state' };\nconst MIX_IT_UP_API = 'http://localhost:8911/api/v2/commands';\nconst NAME_TIME = 240; // Steps a sender's name shows above their ball (4 seconds)\nconst SHAKE_TIME = 30; // Steps the bowl picture wobbles when shaken\nconst BUBBLES = 35; // Bubbles that float up when a bowl breaks\n\n// Each kind of event has a letter, and a colour setting for its balls. 'x' is any other ball.\nconst KIND_COLORS = { f: 'followColor', s: 'subColor', b: 'bitsColor', c: 'chatColor' };\n// Words Mix It Up can send as the \"kind\" parameter, and the letter each one means.\nconst KIND_LETTERS = { follow: 'f', follower: 'f', sub: 's', subscription: 's', gift: 's', bits: 'b', cheer: 'b', chat: 'c', chatter: 'c' };\n\n// The starting values for anything missing from the settings block.\nconst SHARED_DEFAULTS = {\n  version: 3,\n  savedAt: 0,\n  ballSize: 30,\n  gravity: 1,\n  bounciness: 0.3,\n  friction: 0.02,\n  bitsPerBall: 100,\n  shards: 7,\n  returnSeconds: 3,\n  cycleBowls: false,\n  breakCommandId: '',\n  emptyToken: '',\n  emptyArmed: false,\n  liveBowlId: '',\n  // Fun\n  showNames: true,\n  colorByEvent: true,\n  followColor: '#4fc3f7',\n  subColor: '#b388ff',\n  bitsColor: '#ffd54f',\n  chatColor: '#69f0ae',\n  bubbles: true,\n  showCounter: false,\n  volume: 0.3, // 0 is silent, 1 is loudest\n  grabBalls: true,\n  ballPictures: ['ball'], // Each ball uses one of these pictures\n  // Gambling mode\n  gambling: false,\n  pegSize: 16,\n  pegBounce: 0.6,\n  pegColor: '#ffffff',\n};\nconst STARTER_OUTLINE = [\n  [104, 420], [110, 486], [127, 549], [154, 607], [191, 658], [236, 699], [287, 730], [342, 750],\n  [400, 756],\n  [458, 750], [513, 730], [564, 699], [609, 658], [646, 607], [673, 549], [690, 486], [696, 420],\n];\nconst BOWL_DEFAULTS = {\n  id: '',\n  name: 'Bowl',\n  picture: 'starter',\n  x: 80,\n  y: 420,\n  width: 640,\n  outline: STARTER_OUTLINE,\n  dropX: 400,\n  dropY: 30,\n  dropWidth: 296,\n  breakMode: 'count', // 'count', 'auto' or 'off'\n  breakAt: null, // Empty means \"work it out from the outline\"\n  // More picture layers (picture is the back one). '' means none.\n  front: '',\n  depth: '',\n  depthInFront: false,\n  frontX: 0, // How far each layer has been pulled away from the back picture\n  frontY: 0,\n  depthX: 0,\n  depthY: 0,\n  pegs: [], // Gambling mode pegs: [x, y] points\n};\n\n// =====================================================================================\n// 2. SMALL HELPERS\n// =====================================================================================\nconst byId = (id) => document.getElementById(id);\nconst distance = ([x1, y1], [x2, y2]) => Math.hypot(x2 - x1, y2 - y1);\nconst random = (min, max) => min + Math.random() * (max - min);\nconst copyOf = (value) => JSON.parse(JSON.stringify(value));\n\nfunction note(message) {\n  console.log('[bowl] ' + message);\n}\n\nfunction newId(prefix) {\n  return prefix + Date.now().toString(36) + Math.random().toString(36).slice(2, 7);\n}\n\nfunction loadImage(src) {\n  return new Promise((resolve, reject) => {\n    const image = new Image();\n    image.onload = () => resolve(image);\n    image.onerror = reject;\n    image.src = src;\n  });\n}\n\n// Browser storage can be switched off or full, so every read and write is allowed to fail.\nfunction readStorage(key) {\n  try {\n    const text = localStorage.getItem(key);\n    return text ? JSON.parse(text) : null;\n  } catch {\n    return null;\n  }\n}\n\nfunction writeStorage(key, value) {\n  try {\n    localStorage.setItem(key, JSON.stringify(value));\n    return true;\n  } catch {\n    return false;\n  }\n}\n\n// =====================================================================================\n// 3. SETTINGS: READING, CHECKING AND WRITING THEM\n// =====================================================================================\n\n// Fills in anything missing with the defaults, so settings from an older copy still work.\nfunction normalizeBowl(raw) {\n  const bowl = { ...BOWL_DEFAULTS, ...raw };\n  bowl.id = bowl.id || newId('bowl');\n  bowl.outline = copyOf(bowl.outline); // Its own copy, so drawing never changes the defaults\n  bowl.pegs = copyOf(bowl.pegs);\n  return bowl;\n}\n\nfunction normalizeSettings(raw) {\n  const settings = { ...SHARED_DEFAULTS, ...raw };\n  // Pictures may be written as one long text or as a list of short lines.\n  settings.pictures = {};\n  for (const [id, data] of Object.entries((raw && raw.pictures) || {})) {\n    settings.pictures[id] = Array.isArray(data) ? data.join('') : data;\n  }\n  settings.bowls = ((raw && raw.bowls) || []).map(normalizeBowl);\n  if (!settings.bowls.length) settings.bowls.push(normalizeBowl({ id: 'bowl1', name: 'Bowl 1' }));\n  if (!settings.bowls.some((bowl) => bowl.id === settings.liveBowlId)) {\n    settings.liveBowlId = settings.bowls[0].id;\n  }\n  return settings;\n}\n\n// The settings written into this file when it was last saved.\nfunction readFileSettings() {\n  try {\n    return normalizeSettings(JSON.parse(byId('bowl-settings').textContent));\n  } catch (error) {\n    note('The settings in this file are damaged, so the defaults are used. ' + error.message);\n    return normalizeSettings({});\n  }\n}\n\n// A copy with only the pictures still in use, so deleted pictures don't take up space.\nfunction tidySettings(settings) {\n  const tidy = copyOf(settings);\n  const inUse = new Set(['starter', ...tidy.ballPictures]);\n  for (const bowl of tidy.bowls) [bowl.picture, bowl.front, bowl.depth].forEach((id) => inUse.add(id));\n  tidy.pictures = {};\n  for (const id of inUse) {\n    if (settings.pictures[id]) tidy.pictures[id] = settings.pictures[id];\n  }\n  return tidy;\n}\n\n// Mix It Up rewrites a dollar sign followed by letters, and a word in curly brackets.\n// These characters are swapped for codes that mean the same thing to JSON.\n// The less-than sign is swapped too, so nothing in the settings can end the script block early.\nfunction makeSafeForMixItUp(text) {\n  return text\n    .replace(/</g, '\\\\u003c')\n    .replace(/\\$/g, '\\\\u0024')\n    .replace(/\\{(?=\\w+\\})/g, '\\\\u007b');\n}\n\n// The settings as text, ready to go into this file.\nfunction settingsToText(settings) {\n  const tidy = tidySettings(settings);\n  for (const id of Object.keys(tidy.pictures)) {\n    const text = tidy.pictures[id];\n    const lines = [];\n    for (let i = 0; i < text.length; i += PICTURE_LINE) lines.push(text.slice(i, i + PICTURE_LINE));\n    tidy.pictures[id] = lines;\n  }\n  const json = JSON.stringify(tidy, null, 1)\n    // Keeps each outline point on one line: [104, 420]\n    .replace(/\\[\\s*(-?[\\d.]+),\\s*(-?[\\d.]+)\\s*\\]/g, (whole, x, y) => '[' + x + ', ' + y + ']');\n  return makeSafeForMixItUp(json);\n}\n\n// A complete copy of this file, with these settings written into it.\nfunction buildFile(settings) {\n  const marker = PAGE_SOURCE.indexOf('id=\"bowl-settings\"');\n  const start = PAGE_SOURCE.indexOf('>', marker) + 1;\n  const end = PAGE_SOURCE.indexOf('</' + 'script>', start);\n  return PAGE_SOURCE.slice(0, start) + '\\n' + settingsToText(settings) + '\\n' + PAGE_SOURCE.slice(end);\n}\n\n// Reads settings pasted as text: either the settings alone, or a whole bowl.html.\nfunction settingsFromText(text) {\n  text = text.trim();\n  const marker = text.indexOf('id=\"bowl-settings\"');\n  if (marker >= 0) {\n    const start = text.indexOf('>', marker) + 1;\n    text = text.slice(start, text.indexOf('</' + 'script>', start));\n  }\n  const raw = JSON.parse(text);\n  if (!Array.isArray(raw.bowls)) throw new Error('No bowls in this text');\n  return normalizeSettings(raw);\n}\n\n// =====================================================================================\n// 4. SHAPES\n// =====================================================================================\n\n// The space inside the outline, treated as a closed shape. Its sign shows which way it was drawn.\nfunction signedArea(outline) {\n  let area = 0;\n  outline.forEach(([x1, y1], i) => {\n    const [x2, y2] = outline[(i + 1) % outline.length];\n    area += x1 * y2 - x2 * y1;\n  });\n  return area / 2;\n}\n\nfunction ballArea(settings) {\n  const radius = settings.ballSize / 2;\n  return Math.PI * radius * radius;\n}\n\n// Roughly how many balls fit, so a reload doesn't rebuild balls that spilled long ago.\nfunction estimateCapacity(bowl, settings) {\n  return Math.ceil(1.5 * Math.abs(signedArea(bowl.outline)) / ballArea(settings));\n}\n\n// A sensible \"Breaks at\" number for this outline and ball size.\nfunction suggestedBreakAt(bowl, settings) {\n  const area = Math.abs(signedArea(bowl.outline));\n  if (area < ballArea(settings)) return Infinity; // No outline yet, so it never fills\n  return Math.max(1, Math.round(FILL_FACTOR * area / ballArea(settings)));\n}\n\n// How many balls this bowl holds before it breaks. Infinity means it doesn't break by count.\nfunction breakLimit(bowl, settings) {\n  if (bowl.breakMode !== 'count') return Infinity;\n  return bowl.breakAt || suggestedBreakAt(bowl, settings);\n}\n\n// The highest point of the outline: its rim.\nfunction rimHeight(outline) {\n  return outline.length ? Math.min(...outline.map(([, y]) => y)) : SIZE;\n}\n\n// Builds a thick wall on the outer side of each stretch of the outline. Balls stop exactly on\n// the drawn line, and thick walls stop fast balls and heavy piles from pushing through.\nfunction makeWalls(outline) {\n  const walls = [];\n  const outward = signedArea(outline) < 0 ? 1 : -1;\n  for (let i = 1; i < outline.length; i++) {\n    const [x1, y1] = outline[i - 1];\n    const [x2, y2] = outline[i];\n    const length = Math.hypot(x2 - x1, y2 - y1);\n    if (!length) continue;\n    const alongX = (x2 - x1) / length;\n    const alongY = (y2 - y1) / length;\n    // Walls overlap at the joints to close the gaps. The two ends stay flush with the line.\n    const before = i > 1 ? WALL / 2 : 0;\n    const after = i < outline.length - 1 ? WALL / 2 : 0;\n    const shift = (after - before) / 2;\n    const x = (x1 + x2) / 2 + alongX * shift - outward * alongY * WALL / 2;\n    const y = (y1 + y2) / 2 + alongY * shift + outward * alongX * WALL / 2;\n    walls.push(Bodies.rectangle(x, y, length + before + after, WALL, {\n      isStatic: true,\n      angle: Math.atan2(y2 - y1, x2 - x1),\n      friction: 1, // Balls touching a wall use the lower friction, so the setting decides.\n    }));\n  }\n  return walls;\n}\n\nfunction centroid(points) {\n  const x = points.reduce((sum, point) => sum + point[0], 0) / points.length;\n  const y = points.reduce((sum, point) => sum + point[1], 0) / points.length;\n  return [x, y];\n}\n\n// Cuts a shape in two along a straight line through a point at an angle.\n// Returns both halves and the crack: the two places where the line crosses the shape's edge.\nfunction cutShape(points, [px, py], angle) {\n  const normalX = -Math.sin(angle);\n  const normalY = Math.cos(angle);\n  const side = ([x, y]) => (x - px) * normalX + (y - py) * normalY;\n  const left = [];\n  const right = [];\n  const crack = [];\n  points.forEach((point, i) => {\n    const next = points[(i + 1) % points.length];\n    const a = side(point);\n    const b = side(next);\n    if (a >= 0) left.push(point);\n    if (a <= 0) right.push(point);\n    if ((a > 0 && b < 0) || (a < 0 && b > 0)) {\n      const t = a / (a - b);\n      const crossing = [point[0] + (next[0] - point[0]) * t, point[1] + (next[1] - point[1]) * t];\n      left.push(crossing);\n      right.push(crossing);\n      crack.push(crossing);\n    }\n  });\n  return { left, right, crack };\n}\n\n// Cracks a width x height rectangle into a number of pieces along random lines.\n// Each time, the biggest piece is cut in two, so the pieces end up roughly even.\nfunction makeShards(width, height, count) {\n  let pieces = [[[0, 0], [width, 0], [width, height], [0, height]]];\n  const cracks = [];\n  const smallest = width * height * 0.02;\n  for (let tries = 0; pieces.length < count && tries < count * 20; tries++) {\n    pieces.sort((a, b) => Math.abs(signedArea(b)) - Math.abs(signedArea(a)));\n    const piece = pieces[0];\n    const [cx, cy] = centroid(piece);\n    const point = [cx + random(-0.15, 0.15) * width, cy + random(-0.15, 0.15) * height];\n    const { left, right, crack } = cutShape(piece, point, random(0, Math.PI));\n    if (left.length < 3 || right.length < 3) continue;\n    if (Math.abs(signedArea(left)) < smallest || Math.abs(signedArea(right)) < smallest) continue;\n    pieces = [left, right, ...pieces.slice(1)];\n    if (crack.length === 2) cracks.push(crack);\n  }\n  return { pieces, cracks };\n}\n\n// =====================================================================================\n// 5. PICTURES\n// =====================================================================================\nconst pictureCache = new Map();\n\n// Loads a picture from the settings once, then remembers it. Gives null if it's missing.\nasync function loadPicture(settings, id) {\n  const source = settings.pictures[id];\n  if (!source) return null;\n  if (!pictureCache.has(source)) pictureCache.set(source, loadImage(source).catch(() => null));\n  return pictureCache.get(source);\n}\n\n// Crops the ball picture to a circle once, so any picture makes a round ball.\nfunction makeBallSprite(image, size) {\n  const sprite = document.createElement('canvas');\n  sprite.width = sprite.height = size * 2;\n  const painter = sprite.getContext('2d');\n  painter.arc(size, size, size, 0, Math.PI * 2);\n  painter.clip();\n  if (!image) {\n    painter.fillStyle = '#ffb02e'; // No picture: a plain orange ball\n    painter.fillRect(0, 0, size * 2, size * 2);\n    return sprite;\n  }\n  const scale = size * 2 / Math.min(image.width, image.height);\n  const width = image.width * scale;\n  const height = image.height * scale;\n  painter.drawImage(image, size - width / 2, size - height / 2, width, height);\n  return sprite;\n}\n\n// One ball per kind of event, recoloured with that event's colour. \"color\" keeps the\n// picture's light and dark, and swaps in the new colour, like a coloured lens.\nfunction makeBallSprites(image, settings) {\n  const sprites = { x: makeBallSprite(image, settings.ballSize) };\n  for (const [kind, key] of Object.entries(KIND_COLORS)) {\n    const sprite = makeBallSprite(image, settings.ballSize);\n    if (settings.colorByEvent) {\n      const painter = sprite.getContext('2d'); // Still clipped to the circle from makeBallSprite\n      painter.globalCompositeOperation = 'color';\n      painter.fillStyle = settings[key];\n      painter.fillRect(0, 0, sprite.width, sprite.height);\n    }\n    sprites[kind] = sprite;\n  }\n  return sprites;\n}\n\n// All of a bowl's picture layers flattened into one picture, for breaking it.\n// Returns the picture and where it goes on the stage (layers pulled apart make it bigger).\nfunction flattenLayers(layers) {\n  const left = Math.min(...layers.map((layer) => layer.x));\n  const top = Math.min(...layers.map((layer) => layer.y));\n  const right = Math.max(...layers.map((layer) => layer.x + layer.width));\n  const bottom = Math.max(...layers.map((layer) => layer.y + layer.height));\n  const canvas = document.createElement('canvas');\n  canvas.width = Math.max(1, Math.round(right - left));\n  canvas.height = Math.max(1, Math.round(bottom - top));\n  const painter = canvas.getContext('2d');\n  for (const layer of layers) painter.drawImage(layer.picture, layer.x - left, layer.y - top, layer.width, layer.height);\n  return { picture: canvas, x: left, y: top, width: canvas.width, height: canvas.height };\n}\n\n// Picks which ball picture a ball gets from its place in the line, the same way every time,\n// so balls keep their look after a reload. (A well-known trick to turn a number into a random-looking one.)\nfunction pickLook(slot, count) {\n  return Math.floor(Math.abs(Math.sin(slot * 12.9898 + 1) * 43758.5453)) % count;\n}\n\n// The bowl picture with crack lines drawn on it. \"source-atop\" only paints where the picture\n// is already visible, so the cracks never show up on its see-through parts.\nfunction makeCrackedPicture(image, width, height, cracks) {\n  const canvas = document.createElement('canvas');\n  canvas.width = Math.max(1, Math.round(width));\n  canvas.height = Math.max(1, Math.round(height));\n  const painter = canvas.getContext('2d');\n  painter.drawImage(image, 0, 0, width, height);\n  painter.globalCompositeOperation = 'source-atop';\n  painter.lineCap = 'round';\n  for (const [color, lineWidth] of [['rgba(0, 0, 0, 0.7)', 5], ['rgba(255, 255, 255, 0.7)', 2]]) {\n    painter.strokeStyle = color;\n    painter.lineWidth = lineWidth;\n    for (const [[x1, y1], [x2, y2]] of cracks) {\n      painter.beginPath();\n      painter.moveTo(x1, y1);\n      painter.lineTo(x2, y2);\n      painter.stroke();\n    }\n  }\n  return canvas;\n}\n\n// =====================================================================================\n// 5b. SOUNDS\n// Made by the browser itself, so there are no sound files. In OBS, tick \"Control audio via\n// OBS\" on the source to hear them on stream.\n// =====================================================================================\nlet audio = null;\n\nfunction playSound(kind, volume) {\n  if (!(volume > 0)) return;\n  try {\n    audio = audio || new AudioContext();\n    if (audio.state === 'suspended') audio.resume();\n    const now = audio.currentTime;\n    const loudness = audio.createGain();\n    loudness.connect(audio.destination);\n    if (kind === 'crash') {\n      // Random crackle that dies away: the sound of something breaking.\n      const length = Math.round(audio.sampleRate * 0.8);\n      const buffer = audio.createBuffer(1, length, audio.sampleRate);\n      const samples = buffer.getChannelData(0);\n      for (let i = 0; i < length; i++) samples[i] = random(-1, 1) * Math.pow(1 - i / length, 3);\n      const noise = audio.createBufferSource();\n      noise.buffer = buffer;\n      noise.connect(loudness);\n      loudness.gain.value = volume;\n      noise.start(now);\n    } else {\n      // A short tone that slides: up for a new ball (\"plip\"), down for a shake (\"bwomp\")\n      // and quickly down for a bubble (\"pop\").\n      const tone = audio.createOscillator();\n      const sounds = {\n        drop: [random(500, 900), 2, 0.12],\n        shake: [220, 0.3, 0.4],\n        pop: [random(700, 1100), 0.2, 0.06],\n      };\n      const [start, slide, length] = sounds[kind] || sounds.drop;\n      const end = start * slide;\n      tone.frequency.setValueAtTime(start, now);\n      tone.frequency.exponentialRampToValueAtTime(end, now + length);\n      loudness.gain.setValueAtTime(volume * 0.4, now);\n      loudness.gain.exponentialRampToValueAtTime(0.001, now + length);\n      tone.connect(loudness);\n      tone.start(now);\n      tone.stop(now + length);\n    }\n  } catch {\n    // No sound available here. Carry on silently.\n  }\n}\n\n// =====================================================================================\n// 6. THE GAME: physics, dropping, breaking and drawing\n// The overlay runs one game with the real ball count. The editor's test view runs another.\n//   state: the numbers this game keeps (balls, bowlId, breaks). The game changes them.\n//   save: called whenever state changes. onBreak: called when a bowl breaks.\n// =====================================================================================\n// Adds balls to a game's count, remembering each ball's kind (one letter per ball in\n// state.kinds) and who sent it (state.names). Both lists line up with the balls still owed.\nfunction owe(state, count, kind, name) {\n  count = Math.min(count, MAX_PER_CALL);\n  state.balls += count;\n  state.kinds += kind.repeat(count);\n  for (let i = 0; i < count; i++) state.names.push(name || null);\n}\n\n// Makes the kinds and names lists exactly as long as the count, for example after an update.\nfunction lineUp(state) {\n  state.kinds = String(state.kinds || '').slice(0, state.balls).padEnd(state.balls, 'x');\n  state.names = (Array.isArray(state.names) ? state.names : []).slice(0, state.balls);\n  while (state.names.length < state.balls) state.names.push(null);\n}\n\nasync function createGame({ canvas, settings, state, save, onBreak }) {\n  const context = canvas.getContext('2d');\n  const engine = Engine.create({ enableSleeping: true });\n  engine.gravity.y = settings.gravity;\n\n  const radius = settings.ballSize / 2;\n  const maxSpeed = 0.75 * (radius + WALL / 2);\n  // One set of coloured balls for each ball picture.\n  const ballImages = await Promise.all(settings.ballPictures.map((id) => loadPicture(settings, id)));\n  const looks = (ballImages.length ? ballImages : [null]).map((image) => makeBallSprites(image, settings));\n\n  const balls = new Set(); // Balls in the bowl\n  const debris = new Set(); // Balls falling away from a broken bowl\n  let shards = []; // Falling pieces of a broken bowl\n  let current = null; // The bowl on screen: its settings, picture, walls and limits\n  let upcoming = null; // The bowl that comes back after a break, once its picture has loaded\n  let phase = 'filling'; // 'filling', 'cracking', 'broken' or 'returning'\n  let phaseStart = 0; // The step the phase began on\n  let steps = 0; // Steps since the game started\n  let dropped = 0; // Balls dropped into this bowl so far\n  let lastDrop = 0; // The step the last ball was dropped on\n  let restingAtTop = 0; // Steps in a row a ball has rested at the rim\n  let stillFor = 0; // Steps in a row every ball in the bowl has been (almost) still\n  let shakeUntil = 0; // The bowl picture wobbles until this step\n  let bubbles = [];\n  let pegs = []; // Gambling mode pegs in the physics world\n  let held = null; // The ball being dragged with the mouse\n  let pointer = null; // Where the mouse is, on the stage\n  let stopped = false;\n\n  function findBowl(id) {\n    return settings.bowls.find((bowl) => bowl.id === id) || settings.bowls[0];\n  }\n\n  // One picture layer: the picture and where it goes. Every layer is as wide as the bowl,\n  // which is what makes layers exported at the same size line up by themselves.\n  async function prepareLayer(bowl, id, dx, dy) {\n    const picture = id ? await loadPicture(settings, id) : null;\n    if (!picture) return null;\n    const height = bowl.width * picture.height / picture.width;\n    return { picture, x: bowl.x + dx, y: bowl.y + dy, width: bowl.width, height };\n  }\n\n  // Gets a bowl ready to show: its pictures, size and limits. Walls are added later.\n  async function prepareBowl(bowl) {\n    const back = await prepareLayer(bowl, bowl.picture, 0, 0);\n    return {\n      bowl,\n      back,\n      depth: await prepareLayer(bowl, bowl.depth, bowl.depthX, bowl.depthY),\n      front: await prepareLayer(bowl, bowl.front, bowl.frontX, bowl.frontY),\n      limit: breakLimit(bowl, settings),\n      capacity: estimateCapacity(bowl, settings),\n      rimY: rimHeight(bowl.outline),\n      walls: [],\n    };\n  }\n\n  function putOnStage(next) {\n    current = next;\n    current.walls = makeWalls(next.bowl.outline);\n    Composite.add(engine.world, current.walls);\n    current.layers = [next.back, next.depth, next.front].filter(Boolean);\n    dropped = 0;\n    restingAtTop = 0;\n    stillFor = 0;\n  }\n\n  // Gambling mode: a small round static body for each peg. Pegs belong to the bowl on stage.\n  function setPegs() {\n    Composite.remove(engine.world, pegs);\n    pegs = settings.gambling ? current.bowl.pegs.map(([x, y]) => Bodies.circle(x, y, settings.pegSize / 2, {\n      isStatic: true,\n      restitution: settings.pegBounce, // How hard balls bounce off\n      friction: 0,\n    })) : [];\n    Composite.add(engine.world, pegs);\n  }\n\n  function setPhase(next) {\n    phase = next;\n    phaseStart = steps;\n  }\n\n  // How many balls should end up in this bowl: everything owed, up to the break limit.\n  function wanted() {\n    return Math.min(state.balls, current.limit);\n  }\n\n  // live is false while rebuilding the pile after a reload: no sound, no name.\n  function dropBall(live) {\n    const { bowl } = current;\n    // Always a little scatter, so balls don't land balanced on top of each other.\n    const scatter = bowl.dropWidth + radius;\n    let x = bowl.dropX + (Math.random() - 0.5) * scatter;\n    if (!live && bowl.outline.length > 1) {\n      // Rebuilding after a reload: straight down into the middle of the bowl, well away from\n      // its rim, so balls that had landed don't get a second chance to miss.\n      const sides = bowl.outline.map(([px]) => px);\n      const left = Math.min(...sides);\n      const width = Math.max(...sides) - left;\n      x = left + width * random(0.2, 0.8);\n    }\n    const ball = Bodies.circle(x, bowl.dropY, radius, {\n      restitution: settings.bounciness,\n      friction: settings.friction,\n      frictionStatic: 0,\n    });\n    // The kinds and names lists line up with the balls owed to this bowl, so this ball's\n    // place in them is the number of balls dropped so far.\n    ball.slot = dropped; // Its place in the line, used if it gets lost\n    ball.kind = state.kinds[dropped] || 'x';\n    ball.look = looks[pickLook(dropped, looks.length)];\n    if (live && settings.showNames && state.names[dropped]) {\n      ball.sender = state.names[dropped]; // Not \"label\": Matter.js already uses that name\n      ball.senderUntil = steps + NAME_TIME;\n    }\n    if (live) playSound('drop', settings.volume);\n    balls.add(ball);\n    Composite.add(engine.world, ball);\n    dropped++;\n    lastDrop = steps;\n  }\n\n  // One step of physics. Fast balls are slowed, and balls that leave the stage are removed.\n  function physicsStep() {\n    Engine.update(engine, TICK);\n    for (const group of [balls, debris]) {\n      for (const ball of group) {\n        // Capped so a fast ball can't jump straight through a wall.\n        if (ball.speed > maxSpeed) Body.setSpeed(ball, maxSpeed);\n        if (ball.position.y > SIZE + settings.ballSize) {\n          group.delete(ball);\n          Composite.remove(engine.world, ball);\n          if (group === balls) lose(ball);\n        }\n      }\n    }\n  }\n\n  // A ball that left the stage while its bowl was standing (it missed, spilled, was shaken\n  // out or dragged out) is gone: it comes off the count, and out of the kinds and names lists.\n  function lose(ball) {\n    if (phase !== 'filling' && phase !== 'returning') return; // A break has counted it already\n    if (held === ball) held = null;\n    state.balls = Math.max(0, state.balls - 1);\n    state.kinds = state.kinds.slice(0, ball.slot) + state.kinds.slice(ball.slot + 1);\n    state.names.splice(ball.slot, 1);\n    for (const other of balls) if (other.slot > ball.slot) other.slot--;\n    dropped = Math.max(0, dropped - 1);\n    save();\n  }\n\n  // Shards aren't part of the physics world. They just fly and spin under gravity.\n  function moveShards() {\n    for (const shard of shards) {\n      shard.vy += 0.28 * settings.gravity; // About as fast as Matter.js makes balls fall\n      shard.x += shard.vx;\n      shard.y += shard.vy;\n      shard.angle += shard.spin;\n    }\n    shards = shards.filter((shard) => shard.y - shard.reach < SIZE);\n    for (const bubble of bubbles) {\n      bubble.age++;\n      if (bubble.popped) continue;\n      bubble.y += bubble.vy; // Bubbles float up...\n      bubble.x += Math.sin(bubble.age * 0.08 + bubble.wobble) * 0.7; // ...wobbling side to side\n      if (bubble.age >= bubble.life || bubble.y < -bubble.size) {\n        bubble.popped = true;\n        bubble.age = 0; // Now counts the steps since it popped\n        playSound('pop', settings.volume);\n      }\n    }\n    bubbles = bubbles.filter((bubble) => !bubble.popped || bubble.age < 10);\n  }\n\n  // Dragging with the mouse: the held ball is pulled towards the pointer each step, so it\n  // still bumps into walls and other balls, and flies on when you let go.\n  function pullHeldBall() {\n    if (!held || !pointer) return;\n    Sleeping.set(held, false);\n    Body.setVelocity(held, { x: (pointer[0] - held.position.x) * 0.3, y: (pointer[1] - held.position.y) * 0.3 });\n  }\n\n  // Does this bowl count as full yet?\n  function checkFull() {\n    const mode = current.bowl.breakMode;\n    if (mode === 'count') {\n      if (dropped < current.limit) return;\n      // Waits for the last balls to land and the pile to settle, so none are left in mid-air.\n      let allStill = true;\n      for (const ball of balls) if (ball.speed > 0.5) allStill = false;\n      stillFor = allStill ? stillFor + 1 : 0;\n      if (stillFor >= FULL_PAUSE || steps - lastDrop >= FULL_WAIT_MAX) breakNow();\n    } else if (mode === 'auto') {\n      // A ball that has stopped moving with its top at or above the rim means the pile is full.\n      // Balls still near the drop point are skipped, because a new ball starts out still.\n      let atTop = false;\n      for (const ball of balls) {\n        const still = ball.speed < 0.3;\n        const belowDrop = ball.position.y > current.bowl.dropY + radius * 2;\n        if (still && belowDrop && ball.position.y - radius <= current.rimY + 2) atTop = true;\n      }\n      restingAtTop = atTop ? restingAtTop + 1 : 0;\n      if (restingAtTop >= RESTING_AT_TOP) breakNow();\n    }\n  }\n\n  function update() {\n    if (stopped) return;\n    steps++;\n    pullHeldBall();\n    physicsStep();\n    moveShards();\n    const age = steps - phaseStart;\n    if (phase === 'filling') checkFull();\n    else if (phase === 'cracking' && age >= CRACK_TIME) shatter();\n    else if (phase === 'broken' && upcoming && age >= settings.returnSeconds * 60) comeBack();\n    else if (phase === 'returning' && age >= FADE_TIME) setPhase('filling');\n  }\n\n  // Step 1 of a break: work out the count, draw cracks and shake. Returns false if it can't break now.\n  function breakNow() {\n    if (phase !== 'filling' && phase !== 'returning') return false;\n    const used = dropped;\n    // Balls above the limit, and balls still waiting to drop, carry over to the next bowl.\n    state.balls = Math.max(0, state.balls - used);\n    state.kinds = state.kinds.slice(used);\n    state.names = state.names.slice(used);\n    state.breaks = (state.breaks || 0) + 1;\n    const nextBowl = pickNextBowl(settings, current.bowl.id);\n    state.bowlId = nextBowl.id; // Saved now, so a reload during the break shows the next bowl\n    save();\n\n    upcoming = null;\n    prepareBowl(nextBowl).then((next) => {\n      upcoming = next;\n    });\n\n    held = null;\n    current.flat = current.layers.length ? flattenLayers(current.layers) : null;\n    if (current.flat) {\n      const { pieces, cracks } = makeShards(current.flat.width, current.flat.height, settings.shards);\n      current.pieces = pieces;\n      current.cracked = makeCrackedPicture(current.flat.picture, current.flat.width, current.flat.height, cracks);\n    }\n    setPhase('cracking');\n    onBreak({ bowlName: current.bowl.name, balls: used, breaks: state.breaks, nextBowlName: nextBowl.name });\n    return true;\n  }\n\n  // Step 2: the walls vanish, the pieces fly apart and every ball falls.\n  function shatter() {\n    Composite.remove(engine.world, current.walls);\n    for (const ball of balls) {\n      ball.collisionFilter = { group: 0, category: DEBRIS.category, mask: DEBRIS.mask };\n      Sleeping.set(ball, false); // A resting ball is \"asleep\" and wouldn't fall otherwise\n      Body.setVelocity(ball, { x: ball.velocity.x + random(-1.5, 1.5), y: ball.velocity.y - random(0, 2) });\n      debris.add(ball);\n    }\n    balls.clear();\n\n    const flat = current.flat;\n    shards = current.cracked ? current.pieces.map((points) => {\n      const [cx, cy] = centroid(points);\n      const shape = points.map(([x, y]) => [x - cx, y - cy]); // Corners, measured from the middle\n      return {\n        shape,\n        reach: Math.max(...shape.map(([x, y]) => Math.hypot(x, y))),\n        picture: current.cracked,\n        offsetX: -cx,\n        offsetY: -cy,\n        x: flat.x + cx,\n        y: flat.y + cy,\n        angle: 0,\n        vx: (cx - flat.width / 2) * 0.012 + random(-1, 1), // Pieces fly outwards from the middle\n        vy: random(-3, -0.5), // and jump up a little first\n        spin: random(-0.05, 0.05),\n      };\n    }) : [];\n\n    playSound('crash', settings.volume);\n    if (settings.bubbles && flat) {\n      for (let i = 0; i < BUBBLES; i++) {\n        bubbles.push({\n          x: flat.x + random(0.15, 0.85) * flat.width,\n          y: flat.y + random(0.2, 0.8) * flat.height,\n          vy: -random(0.8, 2.5),\n          size: random(8, 26),\n          wobble: random(0, 6),\n          age: 0,\n          life: Math.round(random(40, 220)), // Steps until it pops\n          popped: false,\n        });\n      }\n    }\n    setPhase('broken');\n  }\n\n  // Throws every ball in the bowl up into the air. Some may fly out!\n  function shake(strength) {\n    if (phase !== 'filling' && phase !== 'returning') return;\n    shakeUntil = steps + SHAKE_TIME;\n    for (const ball of balls) {\n      Sleeping.set(ball, false);\n      Body.setVelocity(ball, { x: random(-2, 2) * strength, y: -random(3, 7) * strength });\n    }\n    playSound('shake', settings.volume);\n  }\n\n  // Step 3: the next bowl fades in and the waiting balls start dropping again.\n  function comeBack() {\n    putOnStage(upcoming);\n    setPegs();\n    upcoming = null;\n    setPhase('returning');\n  }\n\n  function empty() {\n    Composite.remove(engine.world, [...balls, ...debris]);\n    balls.clear();\n    debris.clear();\n    dropped = 0;\n    restingAtTop = 0;\n    state.balls = 0;\n    state.kinds = '';\n    state.names = [];\n    save();\n  }\n\n  // Rebuilds the pile out of sight after the page loads.\n  function refill() {\n    const target = wanted();\n    dropped = Math.max(0, target - current.capacity); // These would have spilled long ago\n    while (dropped < target) {\n      dropBall(false);\n      for (let i = 0; i < 6; i++) physicsStep();\n    }\n    for (let i = 0; i < 180; i++) physicsStep();\n    lastDrop = steps;\n  }\n\n  function drawBall(ball) {\n    context.save();\n    context.translate(ball.position.x, ball.position.y);\n    context.rotate(ball.angle);\n    const look = ball.look || looks[0];\n    context.drawImage(look[ball.kind] || look.x, -radius, -radius, settings.ballSize, settings.ballSize);\n    context.restore();\n  }\n\n  // White text with a dark edge, readable over anything.\n  function drawText(text, x, y, size) {\n    context.font = 'bold ' + size + 'px system-ui, \"Segoe UI\", sans-serif';\n    context.textAlign = 'center';\n    context.lineWidth = size / 5;\n    context.strokeStyle = 'rgba(0, 0, 0, 0.8)';\n    context.strokeText(text, x, y);\n    context.fillStyle = '#fff';\n    context.fillText(text, x, y);\n  }\n\n  // A see-through bubble with a shine. A popped bubble is a ring that grows and fades.\n  function drawBubble(bubble) {\n    context.beginPath();\n    if (bubble.popped) {\n      context.globalAlpha = 1 - bubble.age / 10;\n      context.arc(bubble.x, bubble.y, bubble.size * (1 + bubble.age / 15), 0, Math.PI * 2);\n      context.strokeStyle = '#fff';\n      context.lineWidth = 2;\n      context.stroke();\n      context.globalAlpha = 1;\n      return;\n    }\n    context.arc(bubble.x, bubble.y, bubble.size, 0, Math.PI * 2);\n    context.fillStyle = 'rgba(170, 220, 255, 0.18)';\n    context.fill();\n    context.strokeStyle = 'rgba(255, 255, 255, 0.75)';\n    context.lineWidth = 2;\n    context.stroke();\n    context.beginPath(); // The shine, top left\n    context.arc(bubble.x - bubble.size * 0.35, bubble.y - bubble.size * 0.35, bubble.size * 0.25, 0, Math.PI * 2);\n    context.fillStyle = 'rgba(255, 255, 255, 0.6)';\n    context.fill();\n  }\n\n  function drawSender(ball) {\n    if (!ball.sender || steps > ball.senderUntil) return;\n    context.globalAlpha = Math.min(1, (ball.senderUntil - steps) / 30); // Fades out at the end\n    drawText(ball.sender, ball.position.x, ball.position.y - radius - 6, 16);\n    context.globalAlpha = 1;\n  }\n\n  function draw() {\n    if (stopped) return;\n    context.clearRect(0, 0, SIZE, SIZE);\n    // The bowl's layers wobble together, and fade in together.\n    let shakeX = 0;\n    let shakeY = 0;\n    if (phase === 'cracking') {\n      const shake = 4 * (steps - phaseStart) / CRACK_TIME; // The shaking grows\n      shakeX = random(-shake, shake);\n      shakeY = random(-shake, shake);\n    } else if (steps < shakeUntil) {\n      shakeX = random(-6, 6);\n      shakeY = random(-6, 6);\n    }\n    const fade = phase === 'returning' ? Math.min(1, (steps - phaseStart) / FADE_TIME) : 1;\n    const drawLayer = (layer) => {\n      if (!layer || phase === 'broken' || phase === 'cracking') return;\n      context.globalAlpha = fade;\n      context.drawImage(layer.picture, layer.x + shakeX, layer.y + shakeY, layer.width, layer.height);\n      context.globalAlpha = 1;\n    };\n    // Behind the balls: the back, and the depth layer unless it goes in front.\n    drawLayer(current.back);\n    if (!current.bowl.depthInFront) drawLayer(current.depth);\n    // While cracking, all layers are shown as one cracked picture.\n    if (phase === 'cracking' && current.cracked) {\n      context.drawImage(current.cracked, current.flat.x + shakeX, current.flat.y + shakeY);\n    }\n    context.fillStyle = settings.pegColor;\n    for (const peg of pegs) {\n      context.beginPath();\n      context.arc(peg.position.x, peg.position.y, settings.pegSize / 2, 0, Math.PI * 2);\n      context.fill();\n    }\n    for (const shard of shards) {\n      context.save();\n      context.translate(shard.x, shard.y);\n      context.rotate(shard.angle);\n      context.beginPath();\n      shard.shape.forEach(([x, y], i) => (i ? context.lineTo(x, y) : context.moveTo(x, y)));\n      context.closePath();\n      context.clip();\n      context.drawImage(shard.picture, shard.offsetX, shard.offsetY);\n      context.restore();\n    }\n    balls.forEach(drawBall);\n    debris.forEach(drawBall);\n    // In front of the balls: the depth layer if ticked, then the front.\n    if (current.bowl.depthInFront) drawLayer(current.depth);\n    drawLayer(current.front);\n    balls.forEach(drawSender);\n    bubbles.forEach(drawBubble);\n    if (settings.showCounter && current && phase !== 'broken') {\n      const count = Number.isFinite(current.limit) ? dropped + ' / ' + current.limit : String(dropped);\n      drawText(count, current.bowl.x + current.bowl.width / 2, current.rimY - 24, 36);\n    }\n    requestAnimationFrame(draw);\n  }\n\n  // ---- Grabbing balls with the mouse ----\n  function toStagePoint(event) {\n    const box = canvas.getBoundingClientRect();\n    return [(event.clientX - box.left) * SIZE / box.width, (event.clientY - box.top) * SIZE / box.height];\n  }\n  function onPointerDown(event) {\n    if (!settings.grabBalls) return;\n    pointer = toStagePoint(event);\n    for (const ball of balls) {\n      if (distance([ball.position.x, ball.position.y], pointer) < radius * 1.4) held = ball;\n    }\n    if (held) canvas.setPointerCapture(event.pointerId); // Keep the ball even if the mouse leaves\n  }\n  function onPointerMove(event) {\n    if (held) pointer = toStagePoint(event);\n  }\n  function onPointerUp() {\n    held = null;\n  }\n  canvas.addEventListener('pointerdown', onPointerDown);\n  canvas.addEventListener('pointermove', onPointerMove);\n  canvas.addEventListener('pointerup', onPointerUp);\n\n  // ---- Start ----\n  putOnStage(await prepareBowl(findBowl(state.bowlId)));\n  refill(); // Pegs come after, so rebuilding the pile doesn't gamble again\n  setPegs();\n\n  const dropTimer = setInterval(() => {\n    const open = phase === 'filling' || phase === 'returning';\n    if (open && dropped < wanted()) dropBall(true);\n  }, DROP_EVERY);\n  const stepTimer = setInterval(update, TICK);\n  draw();\n\n  return {\n    breakNow,\n    empty,\n    shake,\n    stop() {\n      stopped = true;\n      clearInterval(dropTimer);\n      clearInterval(stepTimer);\n      canvas.removeEventListener('pointerdown', onPointerDown);\n      canvas.removeEventListener('pointermove', onPointerMove);\n      canvas.removeEventListener('pointerup', onPointerUp);\n      context.clearRect(0, 0, SIZE, SIZE);\n    },\n    // For checking what's happening, for example from the browser console.\n    info: () => ({ phase, inBowl: balls.size, falling: debris.size, dropped, limit: current.limit, bowl: current.bowl.name, pegs: pegs.length, bubbles: bubbles.length }),\n    positions: () => [...balls].map((ball) => [Math.round(ball.position.x), Math.round(ball.position.y)]),\n  };\n}\n\n// After a break: the same bowl again, or the next one in the list.\nfunction pickNextBowl(settings, currentId) {\n  const list = settings.bowls;\n  const index = list.findIndex((bowl) => bowl.id === currentId);\n  if (!settings.cycleBowls) return list[index] || list[0];\n  return list[(index + 1) % list.length];\n}\n\n// =====================================================================================\n// 7. THE REAL BOWL AND THE FUNCTIONS MIX IT UP CALLS\n// The ball count and the followers already counted are kept in this browser's storage,\n// so they survive OBS restarts and source refreshes.\n// =====================================================================================\nlet activeSettings = null; // The settings in use (the file's in OBS, the editor's in Chrome)\nlet realGame = null;\nlet breakWaiting = false; // breakBowl() was called before the game had loaded\n\nconst realState = Object.assign(\n  { balls: 0, kinds: '', names: [], followers: [], bowlId: '', liveSeen: '', emptyToken: '', breaks: 0 },\n  readStorage(STORAGE.state),\n);\nrealState.balls = Math.max(0, Math.floor(Number(realState.balls)) || 0);\nlineUp(realState);\nconst followers = new Set(Array.isArray(realState.followers) ? realState.followers : []);\n\nfunction saveState() {\n  realState.followers = [...followers];\n  if (!writeStorage(STORAGE.state, realState)) note(\"Couldn't save the ball count in this browser.\");\n}\n\n// Mix It Up sends one object of named texts, such as { count: \"5\" }.\n// Typed in the console it might be a plain 5. This accepts both and picks out the value.\n// With firstIfMissing false, a missing name gives '' instead of the first value.\nfunction pickValue(input, names, firstIfMissing = true) {\n  if (input === null || input === undefined) return '';\n  if (typeof input !== 'object') return firstIfMissing ? input : '';\n  const keys = Object.keys(input);\n  for (const name of names) {\n    const key = keys.find((k) => k.trim().toLowerCase() === name);\n    if (key !== undefined) return input[key];\n  }\n  return keys.length && firstIfMissing ? input[keys[0]] : '';\n}\n\n// The optional \"user\" a ball came from, tidied up, or '' if none was sent.\nfunction pickUser(input) {\n  return String(pickValue(input, ['user', 'username', 'name'], false) || '').trim().replace(/^@/, '').slice(0, 25);\n}\n\n// \"25\", \" 1,000 \", 25 and 25.7 all work. Anything else, like an identifier Mix It Up\n// didn't fill in, gives NaN (\"not a number\") and is ignored.\nfunction toWholeNumber(value) {\n  const text = String(value).trim().replace(/[,\\s]/g, '');\n  if (!/^\\d+(\\.\\d+)?$/.test(text)) return NaN;\n  return Math.floor(Number(text));\n}\n\n// The one place balls are added to the real bowl.\nfunction addKind(count, kind, name) {\n  owe(realState, count, kind, name);\n  saveState();\n  note('+' + count + (name ? ' from ' + name : '') + ' (total ' + realState.balls + ')');\n  return realState.balls;\n}\n\n// Parameters: count (required), and optionally user (who sent it) and kind\n// (follow, sub, bits or chat, for the ball's colour).\nfunction addBalls(input) {\n  const count = toWholeNumber(pickValue(input, ['count', 'balls', 'amount', 'number']));\n  if (!(count > 0)) {\n    note('addBalls ignored, because this is not a number of balls: ' + JSON.stringify(input));\n    return realState.balls;\n  }\n  const kindWord = String(pickValue(input, ['kind', 'type', 'event'], false)).trim().toLowerCase();\n  return addKind(count, KIND_LETTERS[kindWord] || 'x', pickUser(input));\n}\n\nfunction addFollower(input) {\n  const shown = String(pickValue(input, ['username', 'user', 'name', 'follower'])).trim().replace(/^@/, '');\n  const name = shown.toLowerCase(); // Compared in small letters, so \"Sam\" and \"sam\" are the same person\n  if (!name) {\n    note('addFollower ignored, because no username came with it: ' + JSON.stringify(input));\n    return realState.balls;\n  }\n  // Someone who unfollows and follows again only counts once.\n  if (followers.has(name)) {\n    note(name + ' followed before, so no ball this time');\n    return realState.balls;\n  }\n  followers.add(name);\n  return addKind(1, 'f', shown);\n}\n\nfunction addBits(input) {\n  const bits = toWholeNumber(pickValue(input, ['amount', 'bits', 'bitsamount']));\n  if (!(bits > 0)) {\n    note('addBits ignored, because this is not a number of bits: ' + JSON.stringify(input));\n    return realState.balls;\n  }\n  const bitsPerBall = activeSettings ? activeSettings.bitsPerBall : SHARED_DEFAULTS.bitsPerBall;\n  return addKind(Math.max(1, Math.floor(bits / bitsPerBall)), 'b', pickUser(input));\n}\n\nfunction emptyBowl() {\n  realState.balls = 0;\n  lineUp(realState);\n  saveState();\n  if (realGame) realGame.empty();\n  note('Bowl emptied');\n}\n\nfunction breakBowl() {\n  if (realGame) realGame.breakNow();\n  else breakWaiting = true;\n}\n\n// Bounces the pile. Optional parameter: strength, from 0.5 (a nudge) to 3 (chaos). 1.5 if not given.\nfunction shakeBowl(input) {\n  const strength = Number(String(pickValue(input, ['strength', 'power'])).trim());\n  if (realGame) realGame.shake(strength >= 0.5 && strength <= 3 ? strength : 1.5);\n}\n\n// ---- Events Mix It Up sends by itself when the widget's event boxes are ticked ----\n// The names are fixed by Mix It Up. Each one gets a \"data\" object about the event.\n// Untick a box in Mix It Up and that event stops adding balls.\n// The name of the person in data.User (or data.Gifter), or '' if there isn't one.\nfunction nameOf(user) {\n  return (user && (user.DisplayName || user.Username)) || '';\n}\n\nfunction Follow(data) {\n  const user = (data && data.User) || {};\n  addFollower(user.Username || user.DisplayName || '');\n}\n\nfunction Subscription(data) {\n  addKind(1, 's', nameOf(data && data.User)); // New subs and resubs shared in chat\n}\n\nfunction SubscriptionGifted(data) {\n  addKind(1, 's', nameOf(data && (data.Gifter || data.User))); // One gifted sub, labelled with the gifter\n}\n\nfunction MassSubscriptionGifted(data) {\n  const amount = toWholeNumber((data && data.Amount) || (data && data.Users && data.Users.length) || 0);\n  addKind(amount > 0 ? amount : 1, 's', nameOf(data && data.Gifter));\n}\n\nfunction TwitchBits(data) {\n  addBits({ amount: (data && data.Amount) || 0, user: nameOf(data && data.User) });\n}\n\n// Mix It Up counts every chatter's messages. A count of exactly 1 means this is their first one.\nfunction ChatMessageReceived(data) {\n  const user = (data && data.User) || {};\n  if (Number(user.TotalChatMessageSent) === 1) addKind(1, 'c', nameOf(user));\n}\n\n// A new Custom widget comes with example code in its Javascript tab that has functions with\n// the same names (Follow, Subscription...). That code runs after this file, so once the page\n// has loaded, these names are pointed back at the bowl's own functions.\nconst MIX_IT_UP_FUNCTIONS = {\n  addBalls, addFollower, addBits, emptyBowl, breakBowl, shakeBowl,\n  Follow, Subscription, SubscriptionGifted, MassSubscriptionGifted, TwitchBits, ChatMessageReceived,\n};\ndocument.addEventListener('DOMContentLoaded', () => Object.assign(window, MIX_IT_UP_FUNCTIONS));\n\n// Tells Mix It Up the bowl broke, by running a command through its Developer API.\nfunction tellMixItUp(settings, info) {\n  const id = settings.breakCommandId.trim();\n  if (!id) return;\n  fetch(MIX_IT_UP_API + '/' + encodeURIComponent(id), {\n    method: 'POST',\n    headers: { 'Content-Type': 'application/json' },\n    body: JSON.stringify({\n      Arguments: info.bowlName,\n      SpecialIdentifiers: {\n        bowlname: info.bowlName,\n        bowlballs: String(info.balls),\n        bowlbreaks: String(info.breaks),\n        nextbowlname: info.nextBowlName,\n      },\n    }),\n  })\n    .then((response) => note(response.ok ? 'Told Mix It Up the bowl broke' : 'Mix It Up answered ' + response.status))\n    .catch(() => note(\"Couldn't reach Mix It Up's Developer API to say the bowl broke\"));\n}\n\n// =====================================================================================\n// 8. THE OVERLAY\n// =====================================================================================\nasync function startOverlay() {\n  const settings = readFileSettings();\n  activeSettings = settings;\n\n  // \"Empty the real bowl\" in the editor puts a new token in the next copy. It empties once.\n  if (settings.emptyToken && settings.emptyToken !== realState.emptyToken) {\n    realState.emptyToken = settings.emptyToken;\n    realState.balls = 0;\n    note('This copy was made to empty the bowl, so it starts empty');\n  }\n  // A different live bowl chosen in the editor wins. Otherwise keep the bowl from last time.\n  if (realState.liveSeen !== settings.liveBowlId || !settings.bowls.some((bowl) => bowl.id === realState.bowlId)) {\n    realState.bowlId = settings.liveBowlId;\n    realState.liveSeen = settings.liveBowlId;\n  }\n  saveState();\n\n  realGame = await createGame({\n    canvas: byId('stage'),\n    settings,\n    state: realState,\n    save: saveState,\n    onBreak: (info) => {\n      note('The bowl broke! Next: ' + info.nextBowlName);\n      tellMixItUp(settings, info);\n    },\n  });\n  if (breakWaiting) realGame.breakNow();\n}\n\n// =====================================================================================\n// 9. THE EDITOR\n// =====================================================================================\nconst HINTS = {\n  draw: 'Click to add points, or hold and draw. Drag a point to move it, click the line to add one, right-click a point to remove it. Drag the ball to set the drop point.',\n  move: 'Drag to place the pictures. Choose below whether all layers move, or just one. Bowl size resizes them.',\n  pegs: 'Click to add a peg, drag one to move it, right-click one to remove it. Turn pegs on in Gambling mode.',\n};\n// [setting, label, lowest, highest, step]\nconst BOWL_SLIDERS = [\n  ['width', 'Bowl size', 100, 800, 1],\n  ['dropWidth', 'Drop width', 0, 800, 1],\n];\nconst SHARED_SLIDERS = [\n  ['ballSize', 'Ball size', 10, 100, 1],\n  ['gravity', 'Gravity', 0.1, 3, 0.1],\n  ['bounciness', 'Bounciness', 0, 0.9, 0.05],\n  ['friction', 'Friction', 0, 1, 0.01],\n];\nconst BREAK_SLIDERS = [\n  ['shards', 'Shards', 2, 16, 1],\n  ['returnSeconds', 'Comes back after (seconds)', 1, 15, 0.5],\n];\nconst PEG_SLIDERS = [\n  ['pegSize', 'Peg size', 6, 50, 1],\n  ['pegBounce', 'Peg bounce', 0, 1.2, 0.05],\n];\nconst FUN_SLIDERS = [\n  ['volume', 'Sound volume (0 = off)', 0, 1, 0.05],\n];\nconst SVG_NS = 'http://www.w3.org/2000/svg';\n\nlet editingId = ''; // The bowl being edited\nlet mode = 'draw';\nlet drag = null;\nlet saveTimer = null;\nlet testing = false;\nlet testGame = null;\nlet testState = null;\nlet testRun = 0; // Stops an older test from starting after a newer one\nconst history = [];\nconst pictureShapes = new Map(); // Picture id: height divided by width\n\nfunction setStatus(text) {\n  byId('status').textContent = text;\n}\n\nfunction currentBowl() {\n  return activeSettings.bowls.find((bowl) => bowl.id === editingId) || activeSettings.bowls[0];\n}\n\n// Turns a mouse position into a point on the 800 x 800 stage.\nfunction toStage(event) {\n  const point = new DOMPoint(event.clientX, event.clientY).matrixTransform(byId('editor-stage').getScreenCTM().inverse());\n  const clamp = (value) => Math.round(Math.min(SIZE, Math.max(0, value)));\n  return [clamp(point.x), clamp(point.y)];\n}\n\nasync function measurePictures() {\n  for (const [id, source] of Object.entries(activeSettings.pictures)) {\n    if (pictureShapes.has(id)) continue;\n    const image = await loadPicture(activeSettings, id);\n    pictureShapes.set(id, image ? image.height / image.width : 1);\n  }\n  // Data URLs are long, so they're only set when they change.\n  const setSource = (element, attribute, source) => {\n    if (element.getAttribute(attribute) !== source) element.setAttribute(attribute, source || '');\n  };\n  setSource(byId('drop-ball'), 'href', activeSettings.pictures[activeSettings.ballPictures[0]]);\n}\n\n// Puts a picture layer on the editing layer, at its place, or hides it.\nfunction renderLayer(element, preview, id, dx, dy) {\n  const bowl = currentBowl();\n  const source = activeSettings.pictures[id] || '';\n  if (element.getAttribute('href') !== source) element.setAttribute('href', source);\n  if (preview.getAttribute('src') !== source) preview.setAttribute('src', source);\n  element.setAttribute('x', bowl.x + dx);\n  element.setAttribute('y', bowl.y + dy);\n  element.setAttribute('width', bowl.width);\n  element.setAttribute('height', source ? bowl.width * (pictureShapes.get(id) || 1) : 0);\n}\n\n// The ball pictures as small buttons. Clicking one removes it (one always stays).\nfunction renderBallPictures() {\n  byId('ball-pictures').replaceChildren(...activeSettings.ballPictures.map((id, index) => {\n    const button = document.createElement('button');\n    button.title = 'Remove this ball picture';\n    button.innerHTML = '<img alt=\"\"><span>×</span>';\n    button.querySelector('img').src = activeSettings.pictures[id] || '';\n    button.addEventListener('click', () => {\n      if (activeSettings.ballPictures.length < 2) return setStatus('Keep at least one ball picture');\n      activeSettings.ballPictures.splice(index, 1);\n      measurePictures().then(refreshControls);\n      saveNow();\n    });\n    return button;\n  }));\n}\n\n// Draws the editing layer: picture, outline, points and drop point.\nfunction render() {\n  const bowl = currentBowl();\n  renderLayer(byId('bowl'), byId('back-preview'), bowl.picture, 0, 0);\n  renderLayer(byId('bowl-depth'), byId('depth-preview'), bowl.depth, bowl.depthX, bowl.depthY);\n  renderLayer(byId('bowl-front'), byId('front-preview'), bowl.front, bowl.frontX, bowl.frontY);\n\n  byId('pegs').classList.toggle('off', !activeSettings.gambling);\n  byId('pegs').replaceChildren(...bowl.pegs.map(([x, y], index) => {\n    const peg = document.createElementNS(SVG_NS, 'circle');\n    peg.setAttribute('cx', x);\n    peg.setAttribute('cy', y);\n    peg.setAttribute('r', activeSettings.pegSize / 2);\n    peg.setAttribute('fill', activeSettings.pegColor);\n    peg.dataset.peg = index;\n    return peg;\n  }));\n\n  byId('outline').setAttribute('points', bowl.outline.join(' '));\n  byId('handles').replaceChildren(...bowl.outline.map(([x, y], index) => {\n    const handle = document.createElementNS(SVG_NS, 'circle');\n    handle.setAttribute('cx', x);\n    handle.setAttribute('cy', y);\n    handle.setAttribute('r', 7);\n    handle.dataset.index = index;\n    return handle;\n  }));\n\n  const { dropX: x, dropY: y, dropWidth } = bowl;\n  const { ballSize } = activeSettings;\n  const band = byId('drop-band');\n  band.setAttribute('x', x - dropWidth / 2);\n  band.setAttribute('y', y - 5);\n  band.setAttribute('width', dropWidth);\n  const ball = byId('drop-ball');\n  ball.setAttribute('x', x - ballSize / 2);\n  ball.setAttribute('y', y - ballSize / 2);\n  ball.setAttribute('width', ballSize);\n  ball.setAttribute('height', ballSize);\n  const tip = y + ballSize / 2 + 26;\n  byId('drop-arrow').setAttribute('d', 'M' + (x - 3) + ' ' + (tip - 26) + 'h6v14h7l-10 12l-10 -12h7z');\n\n  updateBreakHint();\n}\n\nfunction updateBreakHint() {\n  const bowl = currentBowl();\n  const suggestion = suggestedBreakAt(bowl, activeSettings);\n  const breakAt = byId('break-at');\n  breakAt.placeholder = Number.isFinite(suggestion) ? 'about ' + suggestion : '';\n  byId('break-at-row').hidden = bowl.breakMode !== 'count';\n  const hints = {\n    count: Number.isFinite(suggestion)\n      ? 'Leave the box empty to use about ' + suggestion + ', worked out from the outline and the ball size.'\n      : 'Draw an outline first, or type a number.',\n    auto: 'Breaks when balls come to rest at the top of the outline.',\n    off: 'This bowl never breaks. Extra balls spill over the sides.',\n  };\n  byId('break-hint').textContent = hints[bowl.breakMode];\n}\n\n// Puts every control back in line with the settings, for example after choosing another bowl.\nfunction refreshControls() {\n  const bowl = currentBowl();\n  for (const slider of document.querySelectorAll('[data-setting]')) {\n    const target = slider.dataset.scope === 'bowl' ? bowl : activeSettings;\n    slider.value = target[slider.dataset.setting];\n    slider.closest('.setting').querySelector('output').textContent = slider.value;\n  }\n  byId('break-mode').value = bowl.breakMode;\n  byId('break-at').value = bowl.breakAt || '';\n  byId('bits').value = activeSettings.bitsPerBall;\n  byId('cycle').checked = activeSettings.cycleBowls;\n  for (const box of document.querySelectorAll('[data-check]')) box.checked = activeSettings[box.dataset.check];\n  for (const picker of document.querySelectorAll('[data-color]')) picker.value = activeSettings[picker.dataset.color];\n  for (const box of document.querySelectorAll('[data-bowl-check]')) box.checked = bowl[box.dataset.bowlCheck];\n  renderBallPictures();\n  byId('break-command').value = activeSettings.breakCommandId;\n  renderBowlList();\n  updateResetHint();\n  render();\n}\n\nfunction renderBowlList() {\n  byId('bowl-list').replaceChildren(...activeSettings.bowls.map((bowl) => {\n    const button = document.createElement('button');\n    button.className = 'bowl-item';\n    button.setAttribute('aria-pressed', String(bowl.id === editingId));\n    const name = document.createElement('span');\n    name.textContent = bowl.name;\n    button.append(name);\n    if (bowl.id === activeSettings.liveBowlId) {\n      const badge = document.createElement('span');\n      badge.className = 'badge';\n      badge.textContent = 'Live';\n      button.append(badge);\n    }\n    button.addEventListener('click', () => selectBowl(bowl.id));\n    return button;\n  }));\n  const isLive = editingId === activeSettings.liveBowlId;\n  byId('bowl-live').disabled = isLive;\n  byId('bowl-live').textContent = isLive ? 'This is the live bowl' : 'Make this the live bowl';\n  byId('bowl-delete').disabled = activeSettings.bowls.length < 2;\n}\n\nfunction selectBowl(id) {\n  editingId = id;\n  history.length = 0;\n  refreshControls();\n  if (testing) startTest();\n}\n\n// ---- Saving ----\nfunction saveSoon() {\n  setStatus('Saving…');\n  clearTimeout(saveTimer);\n  saveTimer = setTimeout(saveNow, SAVE_DELAY);\n}\n\nfunction saveNow() {\n  clearTimeout(saveTimer);\n  activeSettings.savedAt = Date.now();\n  const saved = writeStorage(STORAGE.settings, tidySettings(activeSettings));\n  setStatus(saved ? 'Saved' : \"Couldn't save in this browser (pictures too big?). Use Save a copy now.\");\n  if (testing) startTest();\n}\n\n// ---- Drawing the outline and moving things ----\nfunction remember() {\n  const { outline, pegs } = currentBowl();\n  history.push(JSON.stringify({ outline, pegs }));\n}\n\n// Where a new point belongs: the stretch of line it adds the least length to.\nfunction nearestStretch(point) {\n  const { outline } = currentBowl();\n  const detour = (i) => distance(outline[i], point) + distance(point, outline[i + 1]) - distance(outline[i], outline[i + 1]);\n  let best = 0;\n  for (let i = 1; i < outline.length - 1; i++) if (detour(i) < detour(best)) best = i;\n  return best;\n}\n\nfunction startDrag(event) {\n  if (event.button !== 0) return;\n  event.preventDefault();\n  const point = toStage(event);\n  const bowl = currentBowl();\n  const { outline } = bowl;\n  const { target } = event;\n\n  if (target.closest('#drop')) {\n    drag = ([x, y]) => {\n      bowl.dropX = x;\n      bowl.dropY = y;\n    };\n  } else if (mode === 'move') {\n    // Moves the whole bowl, or pulls just one layer away (its offset from the back picture).\n    const what = byId('move-what').value;\n    const keyX = { all: 'x', front: 'frontX', depth: 'depthX' }[what];\n    const keyY = { all: 'y', front: 'frontY', depth: 'depthY' }[what];\n    const offsetX = point[0] - bowl[keyX];\n    const offsetY = point[1] - bowl[keyY];\n    drag = ([x, y]) => {\n      bowl[keyX] = x - offsetX;\n      bowl[keyY] = y - offsetY;\n    };\n  } else if (mode === 'pegs') {\n    remember();\n    let index = target.dataset.peg === undefined ? -1 : Number(target.dataset.peg);\n    if (index < 0) {\n      bowl.pegs.push(point); // A click on empty space adds a peg\n      index = bowl.pegs.length - 1;\n    }\n    drag = (position) => {\n      bowl.pegs[index] = position;\n    };\n  } else if (target.dataset.index !== undefined) {\n    remember();\n    const index = Number(target.dataset.index);\n    drag = (position) => {\n      outline[index] = position;\n    };\n  } else if (target === byId('outline')) {\n    remember();\n    const index = nearestStretch(point) + 1;\n    outline.splice(index, 0, point);\n    drag = (position) => {\n      outline[index] = position;\n    };\n  } else {\n    remember();\n    outline.push(point);\n    drag = (position) => {\n      if (distance(outline.at(-1), position) >= MIN_STEP) outline.push(position);\n    };\n  }\n  render();\n}\n\nfunction removePoint(event) {\n  event.preventDefault();\n  if (mode === 'pegs' && event.target.dataset.peg !== undefined) {\n    remember();\n    currentBowl().pegs.splice(Number(event.target.dataset.peg), 1);\n    render();\n    saveSoon();\n    return;\n  }\n  if (event.target.dataset.index === undefined || mode !== 'draw') return;\n  remember();\n  currentBowl().outline.splice(Number(event.target.dataset.index), 1);\n  render();\n  saveSoon();\n}\n\nfunction setMode(next) {\n  mode = next;\n  byId('editor-stage').classList.toggle('moving', mode === 'move');\n  byId('editor-stage').classList.toggle('pegging', mode === 'pegs');\n  byId('draw-mode').classList.toggle('active', mode === 'draw');\n  byId('move-mode').classList.toggle('active', mode === 'move');\n  byId('peg-mode').classList.toggle('active', mode === 'pegs');\n  byId('move-what').hidden = mode !== 'move';\n  byId('hint').textContent = HINTS[mode];\n}\n\n// ---- Pictures ----\n// Shrinks a picture and turns it into text. WebP is used when it comes out smaller than PNG.\nasync function pictureToText(file, maxSide) {\n  const picture = await loadImage(URL.createObjectURL(file));\n  const scale = Math.min(1, maxSide / Math.max(picture.width, picture.height));\n  const canvas = document.createElement('canvas');\n  canvas.width = Math.max(1, Math.round(picture.width * scale));\n  canvas.height = Math.max(1, Math.round(picture.height * scale));\n  canvas.getContext('2d').drawImage(picture, 0, 0, canvas.width, canvas.height);\n  const png = canvas.toDataURL('image/png');\n  const webp = canvas.toDataURL('image/webp', 0.9);\n  return webp.startsWith('data:image/webp') && webp.length < png.length ? webp : png;\n}\n\n// Adds one picture to the settings and gives back its new id.\nasync function addPicture(file, maxSide) {\n  const id = newId('picture');\n  activeSettings.pictures[id] = await pictureToText(file, maxSide);\n  return id;\n}\n\n// Several pictures chosen at once for a bowl: names with \"front\", \"back\" or \"depth\" go to that\n// layer; the rest fill Back, Front, then Depth, in order.\nfunction sortLayers(files) {\n  const named = (...words) => files.find((file) => words.some((word) => file.name.toLowerCase().includes(word)));\n  const layers = { picture: named('back'), front: named('front'), depth: named('depth', 'shadow', 'inside') };\n  const rest = files.filter((file) => !Object.values(layers).includes(file));\n  for (const layer of ['picture', 'front', 'depth']) if (!layers[layer]) layers[layer] = rest.shift();\n  return layers;\n}\n\nasync function uploadBowlPictures(layer, files) {\n  if (!files.length) return;\n  setStatus('Saving…');\n  const bowl = currentBowl();\n  const layers = files.length > 1 ? sortLayers(files) : { [layer]: files[0] };\n  try {\n    for (const [key, file] of Object.entries(layers)) if (file) bowl[key] = await addPicture(file, MAX_PICTURE);\n  } catch {\n    setStatus(\"That file isn't a picture\");\n    return;\n  }\n  if (files.length > 1) lineUpLayers(bowl);\n  await measurePictures();\n  refreshControls();\n  saveNow();\n}\n\nasync function uploadBallPictures(files) {\n  setStatus('Saving…');\n  try {\n    for (const file of files) activeSettings.ballPictures.push(await addPicture(file, MAX_BALL_PICTURE));\n  } catch {\n    setStatus(\"That file isn't a picture\");\n    return;\n  }\n  await measurePictures();\n  refreshControls();\n  saveNow();\n}\n\n// Puts every layer back exactly over the back picture.\nfunction lineUpLayers(bowl) {\n  bowl.frontX = bowl.frontY = bowl.depthX = bowl.depthY = 0;\n}\n\n// A Plinko-style triangle of pegs between the drop point and the rim.\nfunction pegPattern(bowl) {\n  const rows = 5;\n  const gap = Math.max(50, activeSettings.ballSize * 2.2); // Room for a ball between pegs\n  const top = bowl.dropY + 80;\n  const bottom = rimHeight(bowl.outline) - 60;\n  const step = Math.max(gap * 0.8, (bottom - top) / (rows - 1));\n  bowl.pegs = [];\n  for (let row = 0; row < rows; row++) {\n    for (let i = 0; i <= row + 1; i++) {\n      bowl.pegs.push([Math.round(bowl.dropX + (i - (row + 1) / 2) * gap), Math.round(top + row * step)]);\n    }\n  }\n}\n\n// ---- The test view ----\nasync function startTest() {\n  const run = ++testRun;\n  const balls = testState ? testState.balls : 0;\n  if (testGame) testGame.stop();\n  testGame = null;\n  testState = { balls, kinds: testState ? testState.kinds : '', names: [], bowlId: editingId, breaks: 0 };\n  lineUp(testState);\n  const game = await createGame({\n    canvas: byId('stage'),\n    settings: tidySettings(activeSettings),\n    state: testState,\n    save() {},\n    onBreak() {},\n  });\n  // A newer test started, or testing stopped, while this one was loading.\n  if (run !== testRun || !testing) {\n    game.stop();\n    return;\n  }\n  testGame = game;\n}\n\nfunction stopTest() {\n  testRun++;\n  if (testGame) testGame.stop();\n  testGame = null;\n  testState = null;\n}\n\nfunction toggleTest() {\n  testing = !testing;\n  byId('editor-stage').toggleAttribute('hidden', testing);\n  byId('test-buttons').hidden = !testing;\n  byId('tools').hidden = testing;\n  byId('test-toggle').textContent = testing ? 'Back to editing' : 'Test the physics';\n  byId('test-toggle').classList.toggle('active', testing);\n  if (testing) saveNow(); // Saving starts the test\n  else stopTest();\n}\n\n// ---- Bowls ----\nfunction addBowl() {\n  const bowl = normalizeBowl({ name: 'Bowl ' + (activeSettings.bowls.length + 1) });\n  activeSettings.bowls.push(bowl);\n  selectBowl(bowl.id);\n  saveNow();\n}\n\nfunction duplicateBowl() {\n  const copy = copyOf(currentBowl());\n  copy.id = newId('bowl');\n  copy.name = copy.name + ' copy';\n  activeSettings.bowls.splice(activeSettings.bowls.indexOf(currentBowl()) + 1, 0, copy);\n  selectBowl(copy.id);\n  saveNow();\n}\n\nfunction renameBowl() {\n  const bowl = currentBowl();\n  const name = prompt('New name for this bowl:', bowl.name);\n  if (name === null || !name.trim()) return;\n  bowl.name = name.trim().slice(0, 60);\n  refreshControls();\n  saveNow();\n}\n\nfunction deleteBowl() {\n  const bowl = currentBowl();\n  if (activeSettings.bowls.length < 2) return;\n  if (!confirm('Delete \"' + bowl.name + '\"? This can\\'t be undone.')) return;\n  activeSettings.bowls = activeSettings.bowls.filter((other) => other !== bowl);\n  if (activeSettings.liveBowlId === bowl.id) activeSettings.liveBowlId = activeSettings.bowls[0].id;\n  selectBowl(activeSettings.bowls[0].id);\n  saveNow();\n}\n\n// ---- Getting it onto the stream ----\n\n// \"Empty the real bowl\" only takes effect in the next copy made, and only once.\nfunction settingsForCopy() {\n  if (activeSettings.emptyArmed) {\n    activeSettings.emptyToken = newId('empty');\n    activeSettings.emptyArmed = false;\n    saveNow();\n    updateResetHint();\n  }\n  return activeSettings;\n}\n\nfunction download(name, text, type) {\n  const link = document.createElement('a');\n  link.href = URL.createObjectURL(new Blob([text], { type }));\n  link.download = name;\n  link.click();\n  setTimeout(() => URL.revokeObjectURL(link.href), 10000);\n}\n\nasync function copyText(text) {\n  try {\n    await navigator.clipboard.writeText(text);\n    return true;\n  } catch {\n    const area = document.createElement('textarea');\n    area.value = text;\n    document.body.append(area);\n    area.select();\n    const copied = document.execCommand('copy');\n    area.remove();\n    return copied;\n  }\n}\n\n// A Mix It Up widget file. Mix It Up reads it with Overlay Widgets, Import.\n// The names and numbers below come from Mix It Up's own source code:\n//   Type 999 = Custom widget, DisplayOption 1 = Single Widget URL.\nfunction buildWidgetFile(settings) {\n  const blank = '00000000-0000-0000-0000-000000000000';\n  const widget = {\n    Name: 'Twitch Bowl',\n    Item: {\n      ID: crypto.randomUUID ? crypto.randomUUID() : blank, // Mix It Up gives it a new ID on import anyway\n      HTML: buildFile(settings),\n      CSS: '',\n      Javascript: '',\n      Version: 0,\n      OverlayEndpointID: blank,\n      Type: 999,\n      DisplayOption: 1,\n      Width: 800,\n      Height: 800,\n      PositionType: 0,\n      XPosition: 0,\n      YPosition: 0,\n      XMaximum: 0,\n      YMaximum: 0,\n      Layer: 0,\n      // The widget's event boxes. These four feed Follow, Subscription..., TwitchBits and\n      // ChatMessageReceived above.\n      Follows: true,\n      TwitchSubscriptions: true,\n      TwitchBits: true,\n      ChatMessages: true,\n      Chatters: false,\n      Raids: false,\n      TwitchPowerUps: false,\n      Donations: false,\n    },\n    IsEnabled: true,\n    RefreshTime: 0,\n  };\n  // Mix It Up needs to know which of its types each part is. Its files mark that with a\n  // \"type\" key that starts with a dollar sign, added here so this file never contains one.\n  const typeKey = String.fromCharCode(36) + 'type';\n  const json = JSON.stringify(widget, null, 2)\n    .replace('{\\n  \"Name\"', '{\\n  \"' + typeKey + '\": \"MixItUp.Base.Model.Overlay.Widgets.OverlayWidgetV3Model, MixItUp.Base\",\\n  \"Name\"')\n    .replace('\"Item\": {\\n', '\"Item\": {\\n    \"' + typeKey + '\": \"MixItUp.Base.Model.Overlay.OverlayCustomV3Model, MixItUp.Base\",\\n');\n  return json;\n}\n\nfunction updateResetHint() {\n  const armed = activeSettings.emptyArmed;\n  byId('reset-hint').textContent = armed\n    ? 'The next copy you make (widget, copy or saved file) empties the real bowl once, when Mix It Up loads it.'\n    : 'Your real bowl lives in Mix It Up. The quickest way to empty it is a chat command (MIXITUP_SETUP.md). Or use this button, then make a new copy.';\n  byId('reset-hint').classList.toggle('warning', armed);\n  byId('reset-cancel').hidden = !armed;\n}\n\n// ---- Export, import and the pop-up box ----\nfunction openDialog({ title, hint, text, actionLabel, onAction }) {\n  byId('dialog-title').textContent = title;\n  byId('dialog-hint').textContent = hint;\n  byId('dialog-text').value = text;\n  byId('dialog-action').textContent = actionLabel;\n  byId('dialog-action').onclick = onAction;\n  byId('text-dialog').showModal();\n}\n\nfunction exportSettings() {\n  openDialog({\n    title: 'Export settings',\n    hint: 'A backup of every bowl, picture and setting. Keep it somewhere safe, or send it to someone.',\n    text: settingsToText(activeSettings),\n    actionLabel: 'Copy',\n    onAction: async () => setStatus(await copyText(byId('dialog-text').value) ? 'Settings copied' : \"Couldn't copy. Select the text and copy it yourself.\"),\n  });\n}\n\nfunction importSettings() {\n  openDialog({\n    title: 'Import settings',\n    hint: 'Paste exported settings, or a whole bowl.html, then press Use these settings.',\n    text: '',\n    actionLabel: 'Use these settings',\n    onAction: async () => {\n      let imported;\n      try {\n        imported = settingsFromText(byId('dialog-text').value);\n      } catch {\n        byId('dialog-hint').textContent = \"That isn't bowl settings. Check you pasted all of it.\";\n        return;\n      }\n      if (!confirm('Replace all your bowls and settings with these?')) return;\n      byId('text-dialog').close();\n      useSettings(imported);\n      saveNow();\n      setStatus('Settings imported');\n    },\n  });\n}\n\nasync function useSettings(settings) {\n  activeSettings = settings;\n  editingId = settings.liveBowlId;\n  history.length = 0;\n  pictureShapes.clear();\n  await measurePictures();\n  refreshControls();\n}\n\n// ---- Building the panel ----\nfunction buildSliders(container, list, scope) {\n  for (const [key, label, min, max, step] of list) {\n    const row = document.createElement('label');\n    row.className = 'setting';\n    row.innerHTML = '<span></span><output></output><input type=\"range\">';\n    row.querySelector('span').textContent = label;\n    const slider = row.querySelector('input');\n    Object.assign(slider, { min, max, step });\n    slider.dataset.setting = key;\n    slider.dataset.scope = scope;\n    slider.addEventListener('input', () => {\n      const target = scope === 'bowl' ? currentBowl() : activeSettings;\n      target[key] = Number(slider.value);\n      row.querySelector('output').textContent = slider.value;\n      render();\n      saveSoon();\n    });\n    byId(container).append(row);\n  }\n}\n\nasync function startEditor() {\n  document.body.classList.add('editing');\n  byId('panel').hidden = false;\n  byId('editor-stage').removeAttribute('hidden'); // SVG has no .hidden, so the attribute is used\n\n  // Edits saved in this browser win, unless this file was saved more recently.\n  const fileSettings = readFileSettings();\n  const stored = readStorage(STORAGE.settings);\n  const storedIsNewer = stored && stored.savedAt > fileSettings.savedAt;\n  await useSettings(storedIsNewer ? normalizeSettings(stored) : fileSettings);\n\n  buildSliders('bowl-sliders', BOWL_SLIDERS, 'bowl');\n  buildSliders('shared-sliders', SHARED_SLIDERS, 'shared');\n  buildSliders('break-sliders', BREAK_SLIDERS, 'shared');\n  buildSliders('fun-sliders', FUN_SLIDERS, 'shared');\n  buildSliders('peg-sliders', PEG_SLIDERS, 'shared');\n  setMode('draw');\n  refreshControls();\n  setStatus(storedIsNewer ? 'Loaded your edits from this browser' : 'Ready');\n\n  // Drawing on the stage\n  byId('editor-stage').addEventListener('pointerdown', startDrag);\n  byId('editor-stage').addEventListener('contextmenu', removePoint);\n  window.addEventListener('pointermove', (event) => {\n    if (!drag) return;\n    drag(toStage(event));\n    render();\n  });\n  window.addEventListener('pointerup', () => {\n    if (!drag) return;\n    drag = null;\n    saveSoon();\n  });\n  byId('draw-mode').addEventListener('click', () => setMode('draw'));\n  byId('move-mode').addEventListener('click', () => setMode('move'));\n  byId('peg-mode').addEventListener('click', () => setMode('pegs'));\n  byId('undo').addEventListener('click', () => {\n    if (!history.length) return;\n    Object.assign(currentBowl(), JSON.parse(history.pop())); // Outline and pegs as they were\n    render();\n    saveSoon();\n  });\n  byId('clear').addEventListener('click', () => {\n    remember();\n    currentBowl().outline = [];\n    render();\n    saveSoon();\n  });\n\n  // Bowls\n  byId('bowl-add').addEventListener('click', addBowl);\n  byId('bowl-duplicate').addEventListener('click', duplicateBowl);\n  byId('bowl-rename').addEventListener('click', renameBowl);\n  byId('bowl-delete').addEventListener('click', deleteBowl);\n  byId('bowl-live').addEventListener('click', () => {\n    activeSettings.liveBowlId = editingId;\n    renderBowlList();\n    saveNow();\n  });\n\n  // Pictures\n  for (const input of document.querySelectorAll('[data-layer]')) {\n    input.addEventListener('change', () => {\n      uploadBowlPictures(input.dataset.layer, [...input.files]);\n      input.value = ''; // So the same file can be chosen again after editing it.\n    });\n  }\n  byId('ball-file').addEventListener('change', (event) => {\n    uploadBallPictures([...event.target.files]);\n    event.target.value = '';\n  });\n  byId('remove-front').addEventListener('click', () => {\n    currentBowl().front = '';\n    render();\n    saveNow();\n  });\n  byId('remove-depth').addEventListener('click', () => {\n    currentBowl().depth = '';\n    render();\n    saveNow();\n  });\n  byId('line-up').addEventListener('click', () => {\n    lineUpLayers(currentBowl());\n    render();\n    saveNow();\n  });\n  for (const box of document.querySelectorAll('[data-bowl-check]')) {\n    box.addEventListener('change', () => {\n      currentBowl()[box.dataset.bowlCheck] = box.checked;\n      saveSoon();\n    });\n  }\n\n  // Gambling mode\n  byId('peg-pattern').addEventListener('click', () => {\n    remember();\n    pegPattern(currentBowl());\n    render();\n    saveNow();\n  });\n  byId('clear-pegs').addEventListener('click', () => {\n    remember();\n    currentBowl().pegs = [];\n    render();\n    saveNow();\n  });\n\n  // Settings that aren't sliders\n  byId('break-mode').addEventListener('change', () => {\n    currentBowl().breakMode = byId('break-mode').value;\n    updateBreakHint();\n    saveSoon();\n  });\n  byId('break-at').addEventListener('change', () => {\n    const value = Math.round(Number(byId('break-at').value));\n    currentBowl().breakAt = value > 0 ? value : null;\n    byId('break-at').value = currentBowl().breakAt || '';\n    saveSoon();\n  });\n  byId('bits').addEventListener('change', () => {\n    activeSettings.bitsPerBall = Math.max(1, Math.round(Number(byId('bits').value)) || 1);\n    byId('bits').value = activeSettings.bitsPerBall;\n    saveSoon();\n  });\n  byId('cycle').addEventListener('change', () => {\n    activeSettings.cycleBowls = byId('cycle').checked;\n    saveSoon();\n  });\n  for (const box of document.querySelectorAll('[data-check]')) {\n    box.addEventListener('change', () => {\n      activeSettings[box.dataset.check] = box.checked;\n      render();\n      saveSoon();\n    });\n  }\n  for (const picker of document.querySelectorAll('[data-color]')) {\n    picker.addEventListener('change', () => {\n      activeSettings[picker.dataset.color] = picker.value;\n      render();\n      saveSoon();\n    });\n  }\n  byId('break-command').addEventListener('change', () => {\n    activeSettings.breakCommandId = byId('break-command').value.trim();\n    saveSoon();\n  });\n\n  // Testing\n  byId('test-toggle').addEventListener('click', toggleTest);\n  byId('test-empty').addEventListener('click', () => testGame && testGame.empty());\n  byId('test-break').addEventListener('click', () => testGame && testGame.breakNow());\n  byId('test-shake').addEventListener('click', () => testGame && testGame.shake(1.5));\n  for (const button of document.querySelectorAll('[data-add]')) {\n    button.addEventListener('click', () => {\n      if (testState) owe(testState, Number(button.dataset.add), 'x', null);\n    });\n  }\n  for (const button of document.querySelectorAll('[data-kind]')) {\n    button.addEventListener('click', () => {\n      if (testState) owe(testState, 1, button.dataset.kind, 'TestViewer');\n    });\n  }\n\n  // Putting it on stream\n  byId('download-widget').addEventListener('click', () => {\n    download('Twitch Bowl.miuoverlay', buildWidgetFile(settingsForCopy()), 'application/json');\n    setStatus('Widget downloaded. In Mix It Up: Overlay Widgets, Import.');\n  });\n  byId('copy-for-miu').addEventListener('click', async () => {\n    const copied = await copyText(buildFile(settingsForCopy()));\n    setStatus(copied ? \"Copied. Paste it into the widget's HTML tab in Mix It Up.\" : \"Couldn't copy. Use Save a copy instead.\");\n  });\n  byId('save-copy').addEventListener('click', () => {\n    download('bowl.html', buildFile(settingsForCopy()), 'text/html');\n    setStatus('Saved a copy to your Downloads folder');\n  });\n  byId('export').addEventListener('click', exportSettings);\n  byId('import').addEventListener('click', importSettings);\n  byId('dialog-close').addEventListener('click', () => byId('text-dialog').close());\n\n  // The real bowl\n  byId('reset').addEventListener('click', () => {\n    if (!confirm('Empty the real bowl? The next copy you put into Mix It Up removes every ball from your stream overlay, once.')) return;\n    activeSettings.emptyArmed = true;\n    saveNow();\n    updateResetHint();\n  });\n  byId('reset-cancel').addEventListener('click', () => {\n    activeSettings.emptyArmed = false;\n    saveNow();\n    updateResetHint();\n  });\n}\n\n// =====================================================================================\n// 10. START: EDITOR OR OVERLAY?\n// #edit or #overlay in the address decides. Otherwise: opened as a file in a normal browser\n// window means the editor; anything else (OBS, Mix It Up, a web address) means the overlay.\n// =====================================================================================\nfunction chooseMode() {\n  const hash = location.hash.toLowerCase();\n  if (hash.includes('overlay')) return 'overlay';\n  if (hash.includes('edit')) return 'editor';\n  let inFrame = true;\n  try {\n    inFrame = window.self !== window.top;\n  } catch {\n    inFrame = true;\n  }\n  const openedAsFile = location.protocol === 'file:';\n  const insideOBS = Boolean(window.obsstudio);\n  return openedAsFile && !insideOBS && !inFrame ? 'editor' : 'overlay';\n}\n\nconst MODE = chooseMode();\n(MODE === 'editor' ? startEditor() : startOverlay()).catch((error) => {\n  note('Something went wrong while starting: ' + error.message);\n  console.error(error);\n});\n</script></body></html>",
    "CSS": "",
    "Javascript": "",
    "Version": 0,
    "OverlayEndpointID": "00000000-0000-0000-0000-000000000000",
    "Type": 999,
    "DisplayOption": 1,
    "Width": 800,
    "Height": 800,
    "PositionType": 0,
    "XPosition": 0,
    "YPosition": 0,
    "XMaximum": 0,
    "YMaximum": 0,
    "Layer": 0,
    "Follows": true,
    "TwitchSubscriptions": true,
    "TwitchBits": true,
    "ChatMessages": true,
    "Chatters": false,
    "Raids": false,
    "TwitchPowerUps": false,
    "Donations": false
  },
  "IsEnabled": true,
  "RefreshTime": 0
}